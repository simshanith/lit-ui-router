# @tools/* is workspace-only; block the scope from resolving to public npm so a
# forgotten `workspace:*` fails loudly instead of fetching a squatter. Pairs
# with linkWorkspacePackages. Host is an RFC 6761 `.invalid` (never resolves).
@tools:registry=https://tools-are-workspace-only.invalid/

# Same for @www/*: the site packages are workspace-only too.
@www:registry=https://sites-are-workspace-only.invalid/
