#!/usr/bin/env bash
#MISE description="Sample the sample-app-lit-e2e suites N times serially and report per-attempt flake"
# Inputs ride the environment (workflow step `env:`), never argv:
#   DEFLAKE_RUNS  attempts, clamped to 1-10 (non-numeric/empty -> 5)
#   DEFLAKE_PORT  dev-server port to verify free between attempts (default 8787)
# Attempts run OUTSIDE turbo so a cached test task can't replay attempt 1.
set -euo pipefail

readonly PORT="${DEFLAKE_PORT:-8787}"
# The workers-sdk#14926 crash surfaces as the client failing to reach the dev server.
readonly CRASH_SIGNATURE="ECONNREFUSED 127.0.0.1:${PORT}"
# Bounded wait for the port to drain after a sweep (seconds).
readonly PORT_WAIT_TRIES=20

runs="${DEFLAKE_RUNS:-5}"
# Guard before the numeric comparisons: `[ abc -lt 1 ]` is a hard error under -e.
case "$runs" in
'' | *[!0-9]*) runs=5 ;;
esac
runs=$((10#$runs)) # strip leading zeros so 010 isn't read as octal
if [ "$runs" -lt 1 ]; then runs=1; fi
if [ "$runs" -gt 10 ]; then runs=10; fi

summary="${GITHUB_STEP_SUMMARY:-/dev/null}"

# True when nothing is LISTENing on $PORT. `ss` ships with the ubuntu runner
# image; where it's absent (local macOS reproduction) we can't verify, so say
# "free" and let the attempt speak for itself.
port_free() {
  command -v ss >/dev/null 2>&1 || return 0
  ! ss -ltn 2>/dev/null | grep -qE "[:.]${PORT}[[:space:]]"
}

# Kill any wrangler/workerd left over from a previous attempt, then wait for the
# port to actually drain. Returns non-zero if the port is still held, so the
# caller can fail that attempt instead of running it against a zombie server
# (which would answer 200 and turn a poisoned attempt green).
#
# Selectors are load-bearing: bare `wrangler` catches the `wrangler.js dev`
# supervisor, `-x workerd` the runtime child. `pkill -f "wrangler dev"` misses
# the supervisor (its argv is the resolved wrangler.js path) — don't "fix" it.
sweep() {
  local phase="$1" i
  pkill -f wrangler 2>/dev/null || true
  pkill -x workerd 2>/dev/null || true
  sleep 1
  if pgrep -f wrangler >/dev/null 2>&1 || pgrep -x workerd >/dev/null 2>&1; then
    echo "[deflake] ${phase}: processes survived SIGTERM, escalating to SIGKILL"
    pkill -9 -f wrangler 2>/dev/null || true
    pkill -9 -x workerd 2>/dev/null || true
    sleep 1
  fi
  for ((i = 1; i <= PORT_WAIT_TRIES; i++)); do
    if port_free; then
      return 0
    fi
    sleep 1
  done
  echo "[deflake] ${phase}: port :${PORT} still held after ${PORT_WAIT_TRIES}s" >&2
  return 1
}

fails=0
crashes=0
declare -a rows=()

for ((i = 1; i <= runs; i++)); do
  log="attempt-${i}.log"
  result=pass
  crash="-"
  note="-"

  # Sweep BEFORE every attempt, the first included: the runner can carry a
  # stray listener in from the build step, and a crashed attempt orphans one.
  if ! sweep "attempt ${i}/${runs}"; then
    result=FAIL
    note="port :${PORT} held — attempt not run"
    fails=$((fails + 1))
    echo "[deflake] attempt ${i}/${runs}: ${result} (${note})"
    rows+=("| ${i} | ${result} | ${crash} | ${note} |")
    continue
  fi

  echo "::group::[deflake] attempt ${i}/${runs}"
  corepack pnpm --filter sample-app-lit-e2e test >"$log" 2>&1 || result=FAIL
  if grep -q "$CRASH_SIGNATURE" "$log"; then
    crash="workers-sdk#14926 class"
    crashes=$((crashes + 1))
  fi
  if [ "$result" = FAIL ]; then
    fails=$((fails + 1))
    tail -60 "$log"
  elif [ "$crash" != "-" ]; then
    note="near miss: passed with the crash signature"
  fi
  echo "::endgroup::"

  echo "[deflake] attempt ${i}/${runs}: ${result} (server crash: ${crash})"
  rows+=("| ${i} | ${result} | ${crash} | ${note} |")
done

verdict="${fails}/${runs} attempts failed; crash signature seen in ${crashes} attempts (including passing ones)"

{
  echo "### Deflake e2e: ${runs} attempts"
  echo ""
  echo "| attempt | result | crash signature | note |"
  echo "| --- | --- | --- | --- |"
  printf '%s\n' "${rows[@]}"
  echo ""
  echo "**${verdict}**"
} >>"$summary"

echo "[deflake] ${verdict}"
exit "$fails"
