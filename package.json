{
  "name": "lit-ui-router-turborepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check:graph-edges": "turbo run @tools/repo-checks#check:graph-edges",
    "check:knip": "turbo run @tools/repo-checks#check:knip",
    "check:pack": "turbo run check:pack",
    "check:patches": "turbo run @tools/repo-checks#check:patches",
    "check:published-diff": "turbo run resolve:published && turbo run check:published-diff",
    "check:release-closure": "turbo run @tools/release#check:release-closure",
    "check:task-inputs": "turbo run @tools/repo-checks#check:task-inputs",
    "check:workers-builds": "turbo run @tools/workers-builds#check",
    "ci": "turbo run ci",
    "dev": "turbo run dev",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "format:check:root": "oxfmt --check \"*.{md,ts,js,mjs,cjs,json,jsonc,yml,yaml}\" \"!pnpm-lock.yaml\" \"!apps/*/**\" \"!www/**\" \"!examples/**\" \"!packages/**\" \"!tools/**\"",
    "format:check:toml": "mise run format_check_toml",
    "format:root": "oxfmt \"*.{md,ts,js,mjs,cjs,json,jsonc,yml,yaml}\" \"!pnpm-lock.yaml\" \"!apps/*/**\" \"!www/**\" \"!examples/**\" \"!packages/**\" \"!tools/**\"",
    "format:toml": "mise run format_toml",
    "lint": "turbo run lint",
    "lint:actionlint": "mise run lint_actionlint",
    "lint:elements": "lint-elements",
    "lint:elements:snapshot": "lint-elements --update",
    "lint:markdown": "mise run lint_markdown",
    "lint:package-json": "eslint --format tap \"**/package.json\" pnpm-workspace.yaml",
    "lint:root": "oxlint --ignore-pattern apps --ignore-pattern tools --ignore-pattern www --ignore-pattern packages --ignore-pattern examples .",
    "lint:shellcheck": "mise run lint_shellcheck",
    "lint:templates": "lit-analyzer-ts-guard && lint-templates",
    "lint:toml": "mise run lint_toml",
    "lint:zizmor": "mise run lint_zizmor",
    "prepare": "husky",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "typecheck:root": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@tools/compat-guards": "workspace:*",
    "@tools/eslint": "workspace:*",
    "@tools/lint-elements": "workspace:*",
    "@tools/lit-template-lint": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-formatter-tap": "catalog:",
    "eslint-plugin-lit-ui-router": "workspace:*",
    "eslint-plugin-oxlint": "catalog:",
    "eslint-plugin-package-json": "catalog:",
    "eslint-plugin-pnpm": "catalog:",
    "eslint-plugin-turbo": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@12.7.0+sha512.9c56477e360068d6e9dca6a92efb4e46b3dc5a52fcebf3d84d78b9736c0ded589a561621a52f68219a7a39facc63cdc079c3226ef9c9d5f02b79f74e69a807b6"
}
