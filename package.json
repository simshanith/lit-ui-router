{
  "name": "lit-ui-router-turborepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check:docs-api-deps": "node check-docs-api-deps.ts",
    "check:pack": "turbo run check:pack",
    "check:patches": "node check-patches.ts",
    "check:published-diff": "turbo run resolve:published && turbo run check:published-diff",
    "check:workers-builds": "turbo run @tools/workers-builds#check",
    "ci": "turbo run ci",
    "dev": "turbo run dev",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "format:check:root": "oxfmt --check \"*.{md,ts,js,mjs,cjs,json,jsonc,yml,yaml}\" \"!pnpm-lock.yaml\" \"!apps/*/**\" \"!docs/**\" \"!examples/**\" \"!packages/**\" \"!tools/**\"",
    "format:check:toml": "mise run format_check_toml",
    "format:root": "oxfmt \"*.{md,ts,js,mjs,cjs,json,jsonc,yml,yaml}\" \"!pnpm-lock.yaml\" \"!apps/*/**\" \"!docs/**\" \"!examples/**\" \"!packages/**\" \"!tools/**\"",
    "format:toml": "mise run format_toml",
    "lint": "turbo run lint",
    "lint:actionlint": "mise run lint_actionlint",
    "lint:package-json": "eslint --format tap \"**/package.json\" pnpm-workspace.yaml",
    "lint:root": "oxlint --ignore-pattern apps --ignore-pattern tools --ignore-pattern docs --ignore-pattern packages --ignore-pattern examples .",
    "lint:shellcheck": "mise run lint_shellcheck",
    "lint:templates": "lit-analyzer-ts-guard && lint-templates",
    "lint:toml": "mise run lint_toml",
    "lint:zizmor": "mise run lint_zizmor",
    "prepare": "husky",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "typecheck:root": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@tools/compat-guards": "workspace:*",
    "@tools/lit-template-lint": "workspace:*",
    "@tools/shared": "workspace:*",
    "@types/node": "catalog:",
    "diff": "catalog:",
    "eslint": "catalog:",
    "eslint-formatter-tap": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "eslint-plugin-package-json": "catalog:",
    "eslint-plugin-pnpm": "catalog:",
    "eslint-plugin-turbo": "catalog:",
    "husky": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
