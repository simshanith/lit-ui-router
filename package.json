{
  "name": "lit-ui-router-turborepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check:dedupe": "turbo run @tools/repo-checks#check:dedupe",
    "check:graph-edges": "turbo run @tools/repo-checks#check:graph-edges",
    "check:knip": "turbo run @tools/repo-checks#check:knip",
    "check:pack": "turbo run check:pack",
    "check:package-coverage": "turbo run @tools/repo-checks#check:package-coverage",
    "check:patches": "turbo run @tools/repo-checks#check:patches",
    "check:published-diff": "turbo run resolve:published && turbo run check:published-diff",
    "check:release-closure": "turbo run @tools/release#check:release-closure",
    "check:shared-source": "turbo run @tools/repo-checks#check:shared-source",
    "check:single-version": "turbo run @tools/repo-checks#check:single-version",
    "check:task-inputs": "turbo run @tools/repo-checks#check:task-inputs",
    "check:workers-builds": "turbo run @tools/workers-builds#check",
    "ci": "turbo run ci",
    "crap": "turbo run crap",
    "dev": "turbo run dev",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "format:check:root": "oxfmt --check \"*.{md,ts,js,mjs,cjs,json,jsonc,yml,yaml}\" \"!pnpm-lock.yaml\" \"!apps/*/**\" \"!www/**\" \"!examples/**\" \"!packages/**\" \"!tools/**\"",
    "format:check:toml": "mise run format_check_toml",
    "format:root": "oxfmt \"*.{md,ts,js,mjs,cjs,json,jsonc,yml,yaml}\" \"!pnpm-lock.yaml\" \"!apps/*/**\" \"!www/**\" \"!examples/**\" \"!packages/**\" \"!tools/**\"",
    "format:toml": "mise run format_toml",
    "lint": "turbo run lint",
    "lint:actionlint": "mise run lint_actionlint",
    "lint:complexity": "eslint --config tools/eslint/complexity-ceiling.ts --format ./tools/eslint/github-formatter.ts --quiet .",
    "lint:css": "stylelint --max-warnings 0 --globby-options '{\"dot\":true}' \"{apps,examples,packages,tools,www}/**/*.{css,vue,ts,mts,cts,js,mjs,cjs}\"",
    "lint:doc-examples": "check-doc-examples",
    "lint:markdown": "mise run lint_markdown",
    "lint:md-examples": "check-md-examples",
    "lint:package-json": "eslint --format ./tools/eslint/github-formatter.ts \"**/package.json\" pnpm-workspace.yaml",
    "lint:root": "oxlint --ignore-pattern apps --ignore-pattern tools --ignore-pattern www --ignore-pattern packages --ignore-pattern examples .",
    "lint:shellcheck": "mise run lint_shellcheck",
    "lint:templates": "lint-templates",
    "lint:toml": "mise run lint_toml",
    "lint:zizmor": "mise run lint_zizmor",
    "prepare": "husky",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "typecheck:root": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@playwright/cli": "catalog:",
    "@tools/bootstrap": "catalog:workspace",
    "@tools/doc-example-check": "catalog:workspace",
    "@tools/eslint": "catalog:workspace",
    "@tools/lit-template-lint": "catalog:workspace",
    "@tools/md-content-mapper": "catalog:workspace",
    "@tools/oxlint-anti-slop": "catalog:workspace",
    "@tools/shared": "catalog:workspace",
    "@types/node": "catalog:",
    "cf": "catalog:",
    "eslint": "catalog:",
    "eslint-formatter-tap": "catalog:",
    "eslint-plugin-lit-ui-router": "catalog:workspace",
    "eslint-plugin-oxlint": "catalog:",
    "eslint-plugin-package-json": "catalog:",
    "eslint-plugin-pnpm": "catalog:",
    "eslint-plugin-turbo": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "postcss-html": "catalog:",
    "postcss-lit-html": "catalog:workspace",
    "stylelint": "catalog:",
    "stylelint-config-recommended": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
