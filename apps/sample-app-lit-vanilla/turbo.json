{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // umbrella over the two site builds, so `^build` consumers wait for both
    "build": {
      "dependsOn": ["^build", "^transit", "build:vanilla", "build:hash"]
    },
    "build:vanilla": {
      "env": [
        "VITE_GOOGLE_ANALYTICS_TRACKING_ID",
        "VITE_SAMPLE_APP_BASE_URL",
        "VITE_SAMPLE_APP_PUSH_STATE"
      ],
      "dependsOn": ["^build", "^transit"],
      "outputs": ["dist/vanilla/**"]
    },
    "build:hash": {
      "env": [
        "VITE_GOOGLE_ANALYTICS_TRACKING_ID",
        "VITE_SAMPLE_APP_BASE_URL",
        "VITE_SAMPLE_APP_PUSH_STATE"
      ],
      "dependsOn": ["^build", "^transit"],
      "outputs": ["dist/hash/**"]
    },
    "typecheck:tsc": {
      // tsc follows imports and the tsconfig extends chain into the buildless
      // app-layer packages' raw .ts; ^transit hashes them, ^build:types can't
      "dependsOn": ["^build:types", "^transit"]
    }
  }
}
