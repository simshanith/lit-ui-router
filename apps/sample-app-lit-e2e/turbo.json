{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    // One turbo task per Cypress suite, each with its own cache key, so a rerun
    // after a flake costs one suite instead of five.
    //
    // They all assume a dev server is already up. It is: the //:e2e mise task
    // starts one around this whole set, deliberately OUTSIDE the graph — turbo
    // has no server lifecycle, and a `with:` sidecar is never reaped. That is
    // also why these tasks are in no ci:* graph; //:e2e is the only caller, and
    // check:graph-edges plan-checks them precisely because CI never reaches them.
    //
    // The five keys are identical by construction, and the duplication is not
    // reducible: turbo has no task-level `extends`, and check:task-inputs fails
    // any key that drops a tracked file, so per-suite input narrowing is not
    // available either. A source change still busts all five — the win is the
    // single-suite rerun, not spec-level scoping.
    //
    // $TURBO_DEFAULT$: the root task's globs miss the .cy.js specs; served
    // content invalidates via the build edge to @www/lit-ui-router.dev#build.
    // wrangler.jsonc: `wrangler dev` runs in the site package, beside it.
    // CYPRESS_* is pass-through, not env: artifact knobs (video) must not
    // affect cache validity. Videos/screenshots stay uncached side effects.
    "test:e2e:docs": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/www/lit-ui-router.dev/wrangler.jsonc"
      ],
      "env": ["CI"],
      "passThroughEnv": ["WRANGLER_LOG", "CYPRESS_*", "DOCS_DEV_PORT"],
      "outputs": []
    },
    "test:e2e:hash": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/www/lit-ui-router.dev/wrangler.jsonc"
      ],
      "env": ["CI"],
      "passThroughEnv": ["WRANGLER_LOG", "CYPRESS_*", "DOCS_DEV_PORT"],
      "outputs": []
    },
    "test:e2e:mobx": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/www/lit-ui-router.dev/wrangler.jsonc"
      ],
      "env": ["CI"],
      "passThroughEnv": ["WRANGLER_LOG", "CYPRESS_*", "DOCS_DEV_PORT"],
      "outputs": []
    },
    "test:e2e:pushstate": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/www/lit-ui-router.dev/wrangler.jsonc"
      ],
      "env": ["CI"],
      "passThroughEnv": ["WRANGLER_LOG", "CYPRESS_*", "DOCS_DEV_PORT"],
      "outputs": []
    },
    "test:e2e:vanilla": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/www/lit-ui-router.dev/wrangler.jsonc"
      ],
      "env": ["CI"],
      "passThroughEnv": ["WRANGLER_LOG", "CYPRESS_*", "DOCS_DEV_PORT"],
      "outputs": []
    }
  }
}
