{
  "name": "sample-app-lit-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "deflake": "node ./scripts/deflake-e2e.ts",
    "e2e": "cypress open",
    "format": "oxfmt \"**/*.{ts,js,json,md}\"",
    "format:check": "oxfmt --check \"**/*.{ts,js,json,md}\"",
    "lint": "oxlint .",
    "test:e2e:docs": "cypress run --config-file cypress.docs.config.ts",
    "test:e2e:hash": "node ./scripts/cypress-suite.ts hash",
    "test:e2e:mobx": "node ./scripts/cypress-suite.ts mobx",
    "test:e2e:pushstate": "cypress run --expose LOCATION_PLUGIN=pushState --config videosFolder=cypress/videos-pushstate,screenshotsFolder=cypress/screenshots-pushstate",
    "test:e2e:vanilla": "cypress run"
  },
  "dependencies": {
    "@www/lit-ui-router.dev": "workspace:*"
  },
  "devDependencies": {
    "@tools/bootstrap": "workspace:*",
    "@types/node": "catalog:",
    "cypress": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "start-server-and-test": "catalog:",
    "typescript": "catalog:typescript6-compat",
    "typescript-7": "catalog:"
  }
}
