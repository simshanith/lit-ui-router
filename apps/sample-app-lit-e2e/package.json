{
  "name": "sample-app-lit-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "deflake": "node ./scripts/deflake-e2e.ts",
    "docs:start-server": "pnpm --filter @www/lit-ui-router.dev exec wrangler dev --port ${DOCS_DEV_PORT:?}",
    "e2e": "cypress open",
    "format": "oxfmt \"**/*.{ts,js,json,md}\"",
    "format:check": "oxfmt --check \"**/*.{ts,js,json,md}\"",
    "lint": "oxlint .",
    "test:e2e:docs": "cypress run --config-file cypress.docs.config.ts",
    "test:e2e:hash": "cypress run --expose LOCATION_PLUGIN=hash --config baseUrl=http://localhost:${DOCS_DEV_PORT:?}/app-hash/,videosFolder=cypress/videos-hash,screenshotsFolder=cypress/screenshots-hash",
    "test:e2e:mobx": "cypress run --config baseUrl=http://localhost:${DOCS_DEV_PORT:?}/app-mobx/,videosFolder=cypress/videos-mobx,screenshotsFolder=cypress/screenshots-mobx",
    "test:e2e:pushstate": "cypress run --expose LOCATION_PLUGIN=pushState --config videosFolder=cypress/videos-pushstate,screenshotsFolder=cypress/screenshots-pushstate",
    "test:e2e:vanilla": "cypress run",
    "test:hash": "start-server-and-test docs:start-server http://localhost:${DOCS_DEV_PORT:?}/app/ test:e2e:hash",
    "test:pushstate": "start-server-and-test docs:start-server http://localhost:${DOCS_DEV_PORT:?}/app/ test:e2e:pushstate"
  },
  "dependencies": {
    "@www/lit-ui-router.dev": "workspace:*"
  },
  "devDependencies": {
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "cypress": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "start-server-and-test": "catalog:",
    "typescript": "catalog:typescript6-compat",
    "typescript-7": "catalog:",
    "vite": "catalog:"
  }
}
