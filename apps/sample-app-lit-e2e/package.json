{
  "name": "sample-app-lit-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "deflake": "node ./scripts/deflake-e2e.ts",
    "e2e": "playwright test --ui",
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,md}\"",
    "lint:oxlint": "oxlint .",
    "test": "node --test --test-reporter=@tools/shared/test-reporter.ts \"scripts/**/*.test.ts\"",
    "test:e2e:a11y": "node ./scripts/a11y-suite.ts",
    "test:e2e:docs": "playwright test --project=docs",
    "test:e2e:domain-search": "node ./scripts/domain-search-suite.ts",
    "test:e2e:effect": "playwright test --project=effect",
    "test:e2e:hash": "playwright test --project=hash",
    "test:e2e:mobx": "playwright test --project=mobx",
    "test:e2e:pushstate": "playwright test --project=pushstate",
    "test:e2e:signals": "playwright test --project=signals",
    "test:e2e:vanilla": "playwright test --project=vanilla"
  },
  "dependencies": {
    "@www/lit-ui-router.dev": "catalog:workspace"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tools/a11y": "catalog:workspace",
    "@tools/bootstrap": "catalog:workspace",
    "@tools/shared": "catalog:workspace",
    "@types/node": "catalog:",
    "domain-search": "catalog:workspace",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "start-server-and-test": "catalog:",
    "typescript": "catalog:"
  }
}
