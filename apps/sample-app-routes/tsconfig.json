{
  // These pure-data tables feed the docs worker and any server runtime, so
  // this src stays runtime-neutral: no host globals beyond the WinterCG
  // subset, making a node-only API a compile error here. We consume
  // ui-router-server as workspace SOURCE, so tsc compiles its implementation
  // here too — hence naming the same shim package it does. The
  // no-restricted-globals lint (.oxlintrc.json) backstops the same neutrality.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": ["ES2022"],
    "types": ["@tools/wintercg-globals"]
  },
  "include": ["src/**/*"]
}
