    "lint:oxlint": "oxlint .",
    "test": "node --test --test-reporter=@tools/shared/test-reporter.ts \"test/**/*.test.ts\"",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit"
