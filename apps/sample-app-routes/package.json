  "dependencies": {
    "ui-router-server": "catalog:workspace"
  },
  "devDependencies": {
    "@tools/shared": "catalog:workspace",
    "@tools/wintercg-globals": "catalog:workspace",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
