{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // the prerender imports lit-ui-router-ssr's and ui-router-server's dist
      "dependsOn": ["^build", "^transit"],
      "outputs": ["dist/**"]
    },
    // Uncached: it measures the host. The harness's knobs are transport, not inputs.
    "measure:vercel": {
      "cache": false,
      "passThroughEnv": ["DOMAIN_SEARCH_RUNS", "DOMAIN_SEARCH_ORIGIN"]
    },
    "typecheck:tsc": {
      "dependsOn": ["^build:types", "^transit"]
    }
  }
}
