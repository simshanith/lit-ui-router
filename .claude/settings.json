{
  "permissions": {
    "allow": [
      "Bash(npm view:*)",
      "Bash(turbo run lint:*)",
      "Bash(turbo run typecheck:*)",
      "Bash(turbo run format:check:*)",
      "Bash(turbo run check:*)",
      "Bash(turbo query:*)",
      "Bash(mise exec -- node www/atlas.lit-ui-router.dev/generator/ship.mjs:*)",
      "Bash(mise run lint_:*)",
      "Bash(mise tasks:*)",
      "Bash(mise ls:*)",
      "Bash(oxlint:*)",
      "Bash(oxfmt --check:*)",
      "Bash(pnpm exec oxlint:*)",
      "Bash(pnpm exec commitlint:*)",
      "Bash(pnpm peers check:*)",
      "Bash(pnpm run typecheck:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm config get:*)",
      "Bash(pnpm --version)",
      "Bash(npm ls:*)",
      "Bash(npm pack --dry-run:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f www/atlas.lit-ui-router.dev/generator/ship-guard.mjs ] && node www/atlas.lit-ui-router.dev/generator/ship-guard.mjs || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
