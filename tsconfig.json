{
  // Owns the repo's tooling scripts, which Node runs directly via type
  // stripping — so imports carry the .ts extension and nothing is ever emitted.
  // Without this, oxlint's type-aware rules see every import as `any`.
  //
  // Scoped to files no other tsconfig claims: tools/dts-backtest/tsconfig.json
  // covers only fixtures/**, and tools/typedoc-plugin-lit-ui-router has its own.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // Node can only strip types, not transform them: no enums, no namespaces,
    // no parameter properties.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "lib": ["ES2022"],
    // Read by the `//#lint:templates` gate, not by tsc: lit-analyzer resolves
    // the nearest tsconfig from cwd (the repo root) and merges this entry.
    // The unknown-* rules ship at `warn` upstream and warnings alone do not
    // fail a run, so gating them means promoting each to `error`.
    // `no-unknown-event` is the exception: it ships `off` even under `strict`,
    // so `error` is what turns it on at all.
    "plugins": [
      {
        "name": "ts-lit-plugin",
        "strict": true,
        "rules": {
          "no-unknown-attribute": "error",
          "no-unknown-event": "error",
          "no-unknown-property": "error",
          "no-unknown-tag-name": "error"
        }
      }
    ]
  },
  "include": [
    "check-graph-edges.ts",
    "check-patches.ts",
    "check-task-inputs.ts",
    "commitlint.config.ts",
    "eslint.config.ts",
    "eslint.oxlint-directives.ts",
    "eslint-rules/**/*.ts",
    // ambient declaration for the untyped lit-a11y plugin eslint.config.ts loads
    "eslint-plugins.d.ts",
    "examples/build-embeds.ts",
    "tools/dts-backtest/run.ts",
    "tools/vue-check/bin.ts"
  ]
}
