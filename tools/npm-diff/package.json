{
  "name": "@tools/npm-diff",
  "version": "0.0.1",
  "private": true,
  "description": "npm diff between two published versions, read from the registry's tarballs, and the R2 store of each version pair's patch and index that the release diff pages serve",
  "type": "module",
  "exports": {
    ".": "./src/store.ts",
    "./diff-index": "./src/diff-index.ts"
  },
  "scripts": {
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,json,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,json,md}\"",
    "lint:oxlint": "oxlint .",
    "test": "node --test --test-reporter=@tools/shared/test-reporter.ts \"src/*.test.ts\"",
    "test:npm-diff": "node --test --test-reporter=@tools/shared/test-reporter.ts \"src/acceptance/*.test.ts\"",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "binary-extensions": "catalog:",
    "diff": "catalog:"
  },
  "devDependencies": {
    "@tools/shared": "catalog:workspace",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
