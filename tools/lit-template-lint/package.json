{
  "name": "@tools/lit-template-lint",
  "version": "0.0.1",
  "private": true,
  "description": "Type-checks Lit html templates in packages/, apps/ and examples/ src by lowering them to TypeScript and checking them through the TypeScript 7.1 API",
  "bin": {
    "lint-templates": "./src/check.ts"
  },
  "type": "module",
  "scripts": {
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,jsonc,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,jsonc,md}\"",
    "lint:oxlint": "oxlint .",
    "test": "node --test --test-reporter=@tools/shared/test-reporter.ts \"src/**/*.test.ts\"",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tools/bootstrap": "catalog:workspace",
    "@tools/shared": "catalog:workspace",
    "@types/node": "catalog:",
    "@types/webidl2": "catalog:",
    "@vscode/web-custom-data": "catalog:",
    "@webref/elements": "catalog:",
    "@webref/idl": "catalog:",
    "lit": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "parse5": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "typescript-7.1": "catalog:",
    "webidl2": "catalog:"
  }
}
