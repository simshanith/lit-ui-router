{
  "name": "@tools/lit-template-lint",
  "version": "0.0.1",
  "private": true,
  "description": "Runs lit-analyzer's strict ruleset over packages/ and apps/ src as one program-wide pass",
  "bin": {
    "lint-templates": "./src/lint-templates.ts"
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt \"**/*.{ts,js,json,jsonc,md}\"",
    "format:check": "oxfmt --check \"**/*.{ts,js,json,jsonc,md}\"",
    "lint": "oxlint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tools/shared": "workspace:*",
    "@types/node": "catalog:",
    "lit-analyzer": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
