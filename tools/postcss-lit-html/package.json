{
  "name": "@tools/postcss-lit-html",
  "version": "0.0.1",
  "private": true,
  "description": "postcss-lit plus the CSS of <style> elements in lit html and svg templates, as one PostCSS syntax for stylelint",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,md}\"",
    "lint:oxlint": "oxlint .",
    "test": "vitest run",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@babel/parser": "catalog:",
    "@babel/types": "catalog:",
    "parse5": "catalog:",
    "postcss": "catalog:",
    "postcss-lit": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
