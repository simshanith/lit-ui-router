{
  "name": "@tools/lint-elements",
  "version": "0.0.1",
  "private": true,
  "description": "Runs the eslint-plugin-lit / -wc / -lit-a11y pass over packages, apps and examples src, failing on any finding",
  "bin": {
    "lint-elements": "./src/lint-elements.ts"
  },
  "type": "module",
  "scripts": {
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,jsonc,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,jsonc,md}\"",
    "lint:oxlint": "oxlint .",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tools/bootstrap": "catalog:workspace",
    "@tools/shared": "catalog:workspace",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
