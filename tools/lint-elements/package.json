{
  "name": "@tools/lint-elements",
  "version": "0.0.1",
  "private": true,
  "description": "Runs the eslint-plugin-lit / -wc / -lit-a11y pass over packages, apps and examples src, and ratchets its warnings against a committed snapshot",
  "bin": {
    "lint-elements": "./src/lint-elements.ts"
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt \"**/*.{ts,js,json,jsonc,md}\"",
    "format:check": "oxfmt --check \"**/*.{ts,js,json,jsonc,md}\"",
    "lint": "oxlint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tools/shared": "workspace:*",
    "@tools/warn-lanes": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
