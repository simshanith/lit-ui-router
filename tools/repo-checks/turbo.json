{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      // The root test task's src/** inputs would stale-cache this src-less
      // package; over-approximate instead. The extra globs are pnpm-pin.test.ts's
      // read-set: it compares the repo's pnpm version pins against
      // package.json's `packageManager`, so a bump to any of them must re-run it.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/.config/mise/config.toml",
        "$TURBO_ROOT$/.config/mise/mise.lock"
      ]
    },
    // Every check below reads the whole repo, not just this package, so each
    // names its read-set with $TURBO_ROOT$ globs on top of $TURBO_DEFAULT$
    // (which covers the shells and cores that live here).
    "check:patches": {
      // pnpm-lock.yaml carries the patch hashes, so a dependency bump that
      // could rotate a patch target re-runs the check
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/tools/shared/src/**"
      ]
    },
    "check:graph-edges": {
      // any manifest can gain or lose a lane, any turbo.json an edge that
      // selects differently — or stops planning at all
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/**/turbo.json",
        "$TURBO_ROOT$/**/package.json",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/tools/shared/src/**"
      ]
    },
    "check:task-inputs": {
      // the audit is over every planned task, so any turbo.json or manifest
      // can change the verdict
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/**/turbo.json",
        "$TURBO_ROOT$/**/package.json",
        "$TURBO_ROOT$/tools/shared/src/**"
      ]
    }
  }
}
