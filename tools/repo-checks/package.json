{
  "name": "@tools/repo-checks",
  "version": "0.0.1",
  "private": true,
  "description": "Repo-wide invariant checks: turbo graph edges and dry-run plumbing, turbo task input keys, and pnpm patch application",
  "type": "module",
  "scripts": {
    "check:graph-edges": "node check-graph-edges.ts",
    "check:patches": "node check-patches.ts",
    "check:task-inputs": "node check-task-inputs.ts",
    "format": "oxfmt \"**/*.{ts,js,json,jsonc,md}\"",
    "format:check": "oxfmt --check \"**/*.{ts,js,json,jsonc,md}\"",
    "lint": "oxlint .",
    "test": "node --test \"*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tools/bootstrap": "workspace:*",
    "@tools/shared": "workspace:*",
    "@types/node": "catalog:",
    "diff": "catalog:",
    "jsonc-parser": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
