{
  "name": "@tools/eslint",
  "version": "0.0.1",
  "private": true,
  "description": "The repo's ESLint pieces: the local repo/ rule plugin, the oxlint disable-directive stubs, and the custom-element lane the root eslint.config.ts composes",
  "type": "module",
  "exports": {
    "./elements.ts": "./elements.ts",
    "./oxlint-directives.ts": "./oxlint-directives.ts",
    "./rules/index.ts": "./rules/index.ts"
  },
  "scripts": {
    "format": "oxfmt \"**/*.{ts,js,json,jsonc,md}\"",
    "format:check": "oxfmt --check \"**/*.{ts,js,json,jsonc,md}\"",
    "lint": "oxlint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tools/eslint-ts-parser": "workspace:*",
    "@tools/shared": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-lit": "catalog:",
    "eslint-plugin-lit-a11y": "catalog:",
    "eslint-plugin-wc": "catalog:",
    "jsonc-parser": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
