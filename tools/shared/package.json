{
  "name": "@tools/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Cross-workflow tooling helpers: the exec seam, GitHub Actions plumbing, shared source globs, and workspace enumeration",
  "type": "module",
  "exports": {
    "./exec.ts": "./src/exec.ts",
    "./execve.ts": "./src/execve.ts",
    "./gha.core.ts": "./src/gha.core.ts",
    "./gha.ts": "./src/gha.ts",
    "./globs.ts": "./src/globs.ts",
    "./workspace.ts": "./src/workspace.ts"
  },
  "scripts": {
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,jsonc,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,jsonc,md}\"",
    "lint:oxlint": "oxlint .",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@pnpm/logger": "catalog:",
    "@pnpm/types": "catalog:",
    "@pnpm/workspace.projects-reader": "catalog:",
    "@pnpm/workspace.workspace-manifest-reader": "catalog:",
    "@tools/bootstrap": "catalog:workspace",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
