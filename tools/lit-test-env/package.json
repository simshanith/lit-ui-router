{
  "name": "@tools/lit-test-env",
  "version": "0.0.1",
  "private": true,
  "description": "Spec knowledge shared by every lit suite: vitest.setup helpers, router spec helpers, spec fixtures, a semantic DOM matcher and parsed-HTML helpers, minus the lit import itself",
  "type": "module",
  "exports": {
    "./dom.ts": "./src/dom.ts",
    "./fixture.ts": "./src/fixture.ts",
    "./parse-html.ts": "./src/parse-html.ts",
    "./router.ts": "./src/router.ts",
    "./setup.ts": "./src/setup.ts",
    "./ssr-tree.ts": "./src/ssr-tree.ts"
  },
  "scripts": {
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,jsonc,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,jsonc,md}\"",
    "lint:oxlint": "oxlint .",
    "test": "vitest run",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@parse5/tools": "catalog:",
    "@tools/happy-dom": "catalog:workspace",
    "parse5": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@types/node": "catalog:",
    "happy-dom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
