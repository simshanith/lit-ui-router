{
  "name": "@tools/lit-test-env",
  "version": "0.0.1",
  "private": true,
  "description": "vitest.setup knowledge shared by every lit suite: the dev-mode banner suppression and the lit2-compat major assertion, minus the lit import itself",
  "type": "module",
  "exports": {
    "./setup.ts": "./src/setup.ts"
  },
  "scripts": {
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,jsonc,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,jsonc,md}\"",
    "lint:oxlint": "oxlint .",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
