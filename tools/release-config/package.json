{
  "name": "@tools/release-config",
  "version": "0.0.1",
  "private": true,
  "description": "The single release-it config the publishable packages share, including the function-valued changelog partials writer 9 requires",
  "type": "module",
  "exports": {
    ".": "./src/release-it.ts",
    "./notes.ts": "./src/notes.ts"
  },
  "scripts": {
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,jsonc,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,jsonc,md}\"",
    "lint:oxlint": "oxlint .",
    "test": "node --test --test-reporter=@tools/shared/test-reporter.ts \"src/**/*.test.ts\"",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "semver": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@tools/shared": "catalog:workspace",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "conventional-changelog": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
