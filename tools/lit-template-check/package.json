{
  "name": "@tools/lit-template-check",
  "version": "0.0.1",
  "private": true,
  "description": "Spike: type-checks Lit html templates by lowering them to TypeScript and checking through the TypeScript 7 API",
  "bin": {
    "lit-template-check": "./src/check.ts"
  },
  "type": "module",
  "scripts": {
    "check": "node src/check.ts",
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,jsonc,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,jsonc,md}\"",
    "lint:oxlint": "oxlint .",
    "test": "node --test --test-reporter=@tools/shared/test-reporter.ts \"src/**/*.test.ts\"",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tools/bootstrap": "catalog:workspace",
    "@tools/shared": "catalog:workspace",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "parse5": "catalog:",
    "typescript": "catalog:"
  }
}
