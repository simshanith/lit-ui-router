{
  "name": "@tools/warn-lanes",
  "version": "0.0.1",
  "private": true,
  "description": "The warn-only-lane protocol: how a committed warning snapshot is compared, and the marker line a warn lane prints for the CI run summary to read back",
  "type": "module",
  "exports": {
    "./warn-lanes.core.ts": "./src/warn-lanes.core.ts"
  },
  "scripts": {
    "format": "oxfmt \"**/*.{ts,js,json,jsonc,md}\"",
    "format:check": "oxfmt --check \"**/*.{ts,js,json,jsonc,md}\"",
    "lint": "oxlint .",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
