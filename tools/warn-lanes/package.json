{
  "name": "@tools/warn-lanes",
  "version": "0.0.1",
  "private": true,
  "description": "The warn-only-lane protocol: how a committed warning snapshot is compared, and the marker line a warn lane prints for the CI run summary to read back",
  "type": "module",
  "exports": {
    "./warn-lanes.core.ts": "./src/warn-lanes.core.ts"
  },
  "scripts": {
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,jsonc,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,jsonc,md}\"",
    "lint:oxlint": "oxlint .",
    "test": "node --test --test-reporter=@tools/shared/test-reporter.ts \"src/**/*.test.ts\"",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tools/shared": "catalog:workspace",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:"
  }
}
