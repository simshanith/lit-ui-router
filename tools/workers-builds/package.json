{
  "name": "@tools/workers-builds",
  "version": "0.0.1",
  "private": true,
  "description": "Diffs the Cloudflare Workers Builds triggers against the repo-owned desired state, and applies it",
  "type": "module",
  "scripts": {
    "check": "node workers-builds-triggers.ts",
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,jsonc,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,jsonc,md}\"",
    "lint:oxlint": "oxlint .",
    "test": "node --test \"*.test.ts\"",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tools/bootstrap": "catalog:workspace",
    "@types/node": "catalog:",
    "jsonc-parser": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:"
  }
}
