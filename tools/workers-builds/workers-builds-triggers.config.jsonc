// Desired Workers Builds trigger configuration, keyed by site: one entry per
// Worker this repo deploys, each naming the wrangler config that names it.
// `pnpm check:workers-builds --apply` updates Cloudflare
// environment_variables: declared keys only, plaintext only — undeclared live
// vars (TURBO_* cache config and secrets, VITE_*) stay dashboard-managed
{
  "workers": {
    "lit-ui-router.dev": {
      // Repo-relative; the worker name is read from this file, not restated.
      "wranglerConfig": "www/lit-ui-router.dev/wrangler.jsonc",
      "productionBranch": "main",
      // The build and deploy commands are repo scripts, not the steps themselves:
      // the dashboard holds one value for every branch, and a package-manager
      // change (build) or a moved wrangler.jsonc (deploy) needs different steps on
      // its branch than main has. Pinning the paths lets a branch diverge without
      // that reading as drift. The steps and why the install moved out of
      // Cloudflare's hands live in cloudflare-build.sh; the two wrangler
      // invocations, keyed by the trigger the argument names, in
      // cloudflare-deploy.ts.
      // SKIP_DEPENDENCY_INSTALL=1 is what hands the install to that script; without
      // it Cloudflare runs its own corepack-provisioned `pnpm install` first.
      // CYPRESS_INSTALL_BINARY=0 and HUSKY=0 skip install work a docs deploy never
      // uses: the Cypress binary (download + unzip, ~15s) belongs to the e2e suite,
      // and the husky git hooks to a developer checkout. Both mirror what
      // `mise run setup` and the CI workflows already set.
      "production": {
        "build_command": "./tools/workers-builds/cloudflare-build.sh",
        "deploy_command": "./tools/workers-builds/cloudflare-deploy.ts main",
        "environment_variables": {
          "SKIP_DEPENDENCY_INSTALL": "1",
          "CYPRESS_INSTALL_BINARY": "0",
          "HUSKY": "0",
        },
      },
      "preview": {
        "build_command": "./tools/workers-builds/cloudflare-build.sh",
        "deploy_command": "./tools/workers-builds/cloudflare-deploy.ts branch",
        "environment_variables": {
          "SKIP_DEPENDENCY_INSTALL": "1",
          "CYPRESS_INSTALL_BINARY": "0",
          "HUSKY": "0",
        },
      },
    },
    // The Altitude Atlas, once www/atlas.lit-ui-router.dev/wrangler.jsonc exists
    // and its Worker has triggers in the dashboard. A wranglerConfig naming a
    // file that does not exist is a hard error (exit 2), not a skip — the miss
    // is far more often a moved file than an unbuilt site — so this entry stays
    // commented out until that file lands. path_includes is the point of a
    // second entry: two sites in one repo, each building only on the pushes
    // that touch it. Both deploy modes below are placeholders too;
    // cloudflare-deploy.ts still knows only `main` and `branch`, which name the
    // flagship wrangler.jsonc.
    // "atlas.lit-ui-router.dev": {
    //   "wranglerConfig": "www/atlas.lit-ui-router.dev/wrangler.jsonc",
    //   "productionBranch": "main",
    //   "production": {
    //     "build_command": "./tools/workers-builds/cloudflare-build.sh",
    //     "deploy_command": "./tools/workers-builds/cloudflare-deploy.ts atlas-main",
    //     "path_includes": ["www/atlas.lit-ui-router.dev/*"],
    //     "environment_variables": {
    //       "SKIP_DEPENDENCY_INSTALL": "1",
    //       "CYPRESS_INSTALL_BINARY": "0",
    //       "HUSKY": "0",
    //     },
    //   },
    //   "preview": {
    //     "build_command": "./tools/workers-builds/cloudflare-build.sh",
    //     "deploy_command": "./tools/workers-builds/cloudflare-deploy.ts atlas-branch",
    //     "path_includes": ["www/atlas.lit-ui-router.dev/*"],
    //     "environment_variables": {
    //       "SKIP_DEPENDENCY_INSTALL": "1",
    //       "CYPRESS_INSTALL_BINARY": "0",
    //       "HUSKY": "0",
    //     },
    //   },
    // },
  },
}
