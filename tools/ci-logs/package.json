{
  "name": "@tools/ci-logs",
  "version": "0.0.1",
  "private": true,
  "description": "Writes one GitHub Actions run's turbo task logs to a single readable file: executed tasks in full beside a baseline run's, replays by name or in full",
  "bin": {
    "ci-logs": "./src/ci-logs.ts"
  },
  "type": "module",
  "scripts": {
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,json,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,json,md}\"",
    "lint:oxlint": "oxlint .",
    "test": "node --test --test-reporter=@tools/shared/test-reporter.ts \"src/**/*.test.ts\"",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tools/shared": "catalog:workspace",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
