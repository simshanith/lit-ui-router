{
  "name": "@tools/compat-guards",
  "version": "0.0.1",
  "private": true,
  "description": "Catalog-vs-installed guards for the compat lanes: the lit-2 alias against the published lit peer range, and the peer-floor alias against its range's floor",
  "bin": {
    "lit2-compat-guard": "./src/lit2-compat-guard.ts",
    "peer-floor-guard": "./src/peer-floor-guard.ts"
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt \"**/*.{ts,js,json,jsonc,md}\"",
    "format:check": "oxfmt --check \"**/*.{ts,js,json,jsonc,md}\"",
    "lint": "oxlint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tools/shared": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "typescript": "catalog:"
  }
}
