{
  "name": "@tools/embed-heights",
  "version": "0.0.1",
  "private": true,
  "description": "Measures every built docs example in headless Chromium at the docs embed column width and checks the heights the docs reserve for them",
  "bin": {
    "check-embed-heights": "./src/check-embed-heights.ts"
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt \"**/*.{ts,js,json,jsonc,md}\"",
    "format:check": "oxfmt --check \"**/*.{ts,js,json,jsonc,md}\"",
    "lint": "oxlint .",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tools/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  }
}
