{
  "name": "@tools/embed-heights",
  "version": "0.0.1",
  "private": true,
  "description": "Measures every built docs example in headless Chromium at the docs embed column width and checks the heights the docs reserve for them",
  "bin": {
    "check-embed-heights": "./src/check-embed-heights.ts"
  },
  "type": "module",
  "scripts": {
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,jsonc,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,jsonc,md}\"",
    "lint:oxlint": "oxlint .",
    "test": "node --test --test-reporter=@tools/shared/test-reporter.ts \"src/**/*.test.ts\"",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tools/bootstrap": "catalog:workspace"
  },
  "devDependencies": {
    "@tools/shared": "catalog:workspace",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  }
}
