{
  "name": "@tools/bundle-probe",
  "version": "0.0.1",
  "private": true,
  "description": "Dual esbuild/rolldown bundling seam for bundle invariants: declared-deps-only entry checks and per-entry codecov bundle stats",
  "bin": {
    "check-bundle-inputs": "./src/check-bundle-inputs.ts",
    "upload-entry-bundles": "./src/upload-entry-bundles.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/bundle.ts",
    "./entries": "./src/entries.ts"
  },
  "scripts": {
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,jsonc,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,jsonc,md}\"",
    "lint:oxlint": "oxlint .",
    "test": "node --test --test-reporter=@tools/shared/test-reporter.ts \"src/**/*.test.ts\"",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tools/bootstrap": "catalog:workspace",
    "@tools/build_and_test": "catalog:workspace",
    "@tools/shared": "catalog:workspace",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:"
  }
}
