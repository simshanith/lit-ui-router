{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "remoteCache": { "signature": true },
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      // umbrella over own-package passes; no-ops where scripts are absent
      "dependsOn": ["^build", "build:js", "build:types"],
      "outputs": ["dist/**"]
    },
    "build:js": {
      "outputs": ["dist/**/*.js", "dist/**/*.js.map"]
    },
    "build:types": {
      // self-chain to build types transitively
      "dependsOn": ["^build:types"],
      "outputs": ["dist/**/*.d.ts", "dist/**/*.d.ts.map"]
    },
    "test": {
      "dependsOn": ["^test"],
      // $TURBO_DEFAULT$ is the key; the globs only document what the lane reads
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.ts",
        "vitest.config.ts",
        "vitest.setup.ts",
        "cypress.config.ts"
      ],
      "env": ["VITEST_BROWSER_API_PORT", "VITE_EXPECT_LIT_MAJOR", "CI"],
      // CYPRESS_video: CI disables Cypress recording (build-test.yml);
      // strict env mode would scrub the override before it reaches Cypress.
      "passThroughEnv": ["WRANGLER_LOG", "CYPRESS_video"]
    },
    "@tools/dts-backtest#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "fixtures/**",
        "run.ts",
        "tsconfig.fixture*.json"
      ]
    },
    // Full TS version matrix; distinct task name = distinct cache key from
    // the current-leg-only #test above. Runs on main push, not the PR graph.
    "@tools/dts-backtest#test:matrix": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "fixtures/**",
        "run.ts",
        "tsconfig.fixture*.json"
      ]
    },
    "test:coverage": {
      "dependsOn": ["^build", "^test:coverage"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.ts",
        "vitest.config.ts",
        "vitest.setup.ts"
      ],
      "env": ["VITEST_BROWSER_API_PORT", "VITE_EXPECT_LIT_MAJOR", "CI"],
      "outputs": ["coverage/**"]
    },
    // Firefox+WebKit full-suite pass for the vitest packages; chromium
    // correctness rides test:coverage on PRs. Runs on main push, not the
    // PR graph.
    "test:engines": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.ts",
        "vitest.config.ts",
        "vitest.setup.ts"
      ],
      "env": ["VITEST_BROWSER_API_PORT", "VITE_EXPECT_LIT_MAJOR", "CI"]
    },
    // Same unit suites resolved against the lit-2 alias (the 2.x line the
    // published lit peer range covers); cheap enough for the PR graph — no
    // extra browsers, and the alias tracks published lit, so no peer-floor
    // atomicity concern. $TURBO_DEFAULT$ covers the extra configs; the
    // workspace yaml feeds lit2-compat-guard (peer range + alias pin).
    // The lit-2 types ride the sibling typecheck:lit2 task, never chained
    // here: a runtime failure would mask the typecheck result.
    "test:lit2-compat": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/pnpm-workspace.yaml"],
      "env": ["VITEST_BROWSER_API_PORT", "VITE_EXPECT_LIT_MAJOR", "CI"]
    },
    // Same unit suites resolved against the mobx-6 alias (the 6.x line the
    // widened mobx peer range still covers). Mirrors test:lit2-compat: no
    // extra browsers, alias tracks published mobx, workspace yaml feeds
    // mobx6-compat-guard (peer range + alias pin). The mobx-6 types ride the
    // sibling typecheck:mobx6 task, never chained here: a runtime failure
    // would mask the typecheck result.
    "test:mobx6-compat": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/pnpm-workspace.yaml"],
      "env": ["VITEST_BROWSER_API_PORT", "VITE_EXPECT_MOBX_MAJOR", "CI"]
    },
    "lint": {
      "with": [
        "//#lint:root",
        "//#lint:package-json",
        "//#lint:elements",
        "//#lint:markdown",
        "//#lint:workflows",
        "//#lint:templates",
        "//#check:patches",
        "//#check:graph-edges",
        "//#check:release-closure",
        "//#check:task-inputs"
      ],
      // type-aware oxlint resolves cross-package imports to dist d.ts only
      "dependsOn": ["^build:types"],
      // explicit globs hash gitignored files too; dist/ and .cache/ mutate
      // mid-graph (build:js, pack:all staging) and oxlint never reads them
      "inputs": [
        "**/*.ts",
        "**/*.js",
        "!dist/**",
        "!.cache/**",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_DEFAULT$"
      ]
    },
    "//#lint:root": {
      "inputs": [".oxlintrc.json", "$TURBO_DEFAULT$"]
    },
    // lit-analyzer over every tracked src .ts, as ONE program-wide pass (the
    // tag registry is global to the run, so cross-package `<ui-view>` usage
    // only resolves when everything is analyzed together).
    "//#lint:templates": {
      // Cross-package element types come from the published d.ts, not src:
      // with dist absent `<ui-view>` resolves to nothing, so a
      // type-incompatible binding against it goes unreported (the run only
      // fails on unrelated no-missing-import noise). Root has
      // no workspace dep on the packages, so `^build:types` cannot reach
      // them; these are package-qualified for that reason (//#check:graph-edges
      // holds the list to every publishable package with a build:types script).
      "dependsOn": [
        "eslint-plugin-lit-ui-router#build:types",
        "lit-ui-router#build:types",
        "lit-ui-router-mobx#build:types",
        "ui-router-navigation-location-plugin#build:types",
        "ui-router-server#build:types"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        // over-approximate: `**/*.ts` would skip files sitting directly in
        // `src/`, which is exactly the bug these globs used to have
        "packages/*/src/**",
        "apps/*/src/**",
        "examples/*/src/**",
        // examples resolve a published lit-ui-router, so a lockfile bump can
        // change what the analyzer sees without any src change
        "examples/*/package-lock.json",
        "tools/lit-template-lint/src/**",
        "tools/compat-guards/src/**",
        "tools/shared/src/**",
        // carries the `ts-lit-plugin` ruleset lit-analyzer reads from cwd
        "tsconfig.json",
        "pnpm-workspace.yaml"
      ]
    },
    // eslint-plugin-lit / -wc / -lit-a11y over the same src the //#lint:templates
    // gate sees. Syntax-only (no project service, no ^build:types), so it stays
    // off the build path — the class AST is all these rules read.
    "//#lint:elements": {
      "inputs": [
        "$TURBO_DEFAULT$",
        // over-approximate, as //#lint:templates does: `**/*.ts` would skip
        // files sitting directly in `src/`
        "packages/*/src/**",
        "apps/*/src/**",
        "examples/*/src/**",
        "eslint.config.ts",
        "eslint.oxlint-directives.ts",
        "eslint-rules/**/*.ts",
        "tools/lint-elements/src/**",
        // the committed warning floor: raising or lowering it re-runs the lane
        "tools/lint-elements/warnings.json",
        "tools/warn-lanes/src/**",
        // feeds both the oxlint-disable layer and the disable-directive stubs
        ".oxlintrc.json",
        "tools/eslint-ts-parser/src/**"
      ]
    },
    "//#check:patches": {
      // pnpm-lock.yaml carries the patch hashes, so a dependency bump that
      // could rotate a patch target re-runs the check
      "inputs": [
        "$TURBO_DEFAULT$",
        "check-patches.ts",
        "patches/**",
        "pnpm-workspace.yaml",
        "pnpm-lock.yaml",
        "tools/shared/src/**"
      ]
    },
    "//#check:graph-edges": {
      // any manifest can gain or lose a selecting script, any turbo.json an edge
      "inputs": [
        "$TURBO_DEFAULT$",
        "check-graph-edges.ts",
        "**/turbo.json",
        "**/package.json",
        "pnpm-workspace.yaml",
        "tools/shared/src/**"
      ]
    },
    "//#check:release-closure": {
      // pnpm resolves the filter from manifests alone, so this runs before any release lane installs
      "inputs": [
        "$TURBO_DEFAULT$",
        "check-release-closure.ts",
        "**/package.json",
        "pnpm-workspace.yaml",
        ".config/mise/config.toml",
        "tools/shared/src/**"
      ]
    },
    "//#check:task-inputs": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "check-task-inputs.ts",
        "tools/shared/src/**"
      ]
    },
    "//#lint:package-json": {
      // $TURBO_DEFAULT$ so the list can't go stale into a false cache hit;
      // the globs stay as documentation of what the lane actually reads
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/package.json",
        "eslint.config.ts",
        "eslint-rules/**/*.ts",
        "packages/eslint-plugin-lit-ui-router/src/**",
        "pnpm-workspace.yaml",
        ".oxlintrc.json"
      ]
    },
    // Content lint (not config plumbing, so deliberately not under
    // //#lint:workflows): rumdl over every tracked .md. Its own cache group,
    // disjoint from oxfmt's format group, which owns .md *formatting*.
    "//#lint:markdown": {
      "inputs": [
        "**/*.md",
        "!**/node_modules/**",
        "$TURBO_ROOT$/.config/rumdl.toml",
        "$TURBO_ROOT$/.config/mise/tasks/rumdl",
        "$TURBO_ROOT$/.config/mise/mise.lock"
      ]
    },
    // Config-plumbing lint: one //# cache group per tool, aggregated by the
    // virtual //#lint:workflows node (which the lint task pulls in). The
    // lint_workflows mise umbrella covers the same set for the standalone
    // lint-workflows.yml job.
    "//#lint:workflows": {
      // Virtual node: no package.json script, so turbo runs nothing for it — it
      // just fans out (via `with`) to the per-tool tasks, which carry their own
      // cache keys.
      "with": [
        "//#lint:actionlint",
        "//#lint:zizmor",
        "//#lint:toml",
        "//#lint:shellcheck"
      ]
    },
    "//#lint:actionlint": {
      // config.toml holds the task defs, mise.lock the tool pins.
      "inputs": [
        ".github/**",
        "$TURBO_ROOT$/.config/mise/config.toml",
        "$TURBO_ROOT$/.config/mise/mise.lock"
      ]
    },
    "//#lint:zizmor": {
      // zizmor also reads its own config (zizmor.yml).
      "inputs": [
        ".github/**",
        "zizmor.yml",
        "$TURBO_ROOT$/.config/mise/config.toml",
        "$TURBO_ROOT$/.config/mise/mise.lock"
      ]
    },
    "//#lint:toml": {
      // taplo lint over every tracked .toml; same input set as //#format:toml.
      "inputs": [
        "**/*.toml",
        "!**/node_modules/**",
        "$TURBO_ROOT$/.config/taplo.toml",
        "$TURBO_ROOT$/.config/mise/tasks/taplo",
        "$TURBO_ROOT$/.config/mise/mise.lock"
      ]
    },
    "//#lint:shellcheck": {
      // shellcheck over *.sh/*.bash + the extensionless mise task scripts it
      // shebang-scans (vendored sample-app scripts excluded in the task).
      "inputs": [
        "**/*.sh",
        "**/*.bash",
        "!**/node_modules/**",
        "$TURBO_ROOT$/.config/mise/tasks/**",
        "$TURBO_ROOT$/.config/mise/mise.lock"
      ]
    },
    "typecheck": {
      // types come from build:types alone; JS emit stays off the typecheck path
      "dependsOn": ["^build:types"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      // compat typechecks ride along: `turbo run typecheck` is the one command
      // that answers "do the types hold", and `with` propagates their failure
      "with": [
        "//#typecheck:root",
        "typecheck:src",
        "typecheck:lit2",
        "typecheck:mobx6"
      ]
    },
    "typecheck:src": {
      "dependsOn": ["^build:types"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    // src against the lit-2 alias's types; separate from test:lit2-compat so
    // the fast lane reports and caches without waiting on the suites.
    "typecheck:lit2": {
      "dependsOn": ["^build:types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/pnpm-workspace.yaml"
      ]
    },
    // src against the mobx-6 alias's types; separate from test:mobx6-compat so
    // the fast lane reports and caches without waiting on the suites. Gated,
    // unlike typecheck:peer-floor: the alias tracks published mobx.
    "typecheck:mobx6": {
      "dependsOn": ["^build:types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/pnpm-workspace.yaml"
      ]
    },
    "typecheck:peer-floor": {
      // manual-only: not in ci — the floor pin can only reference published
      // versions, so gating would break atomic core-API + mobx-adoption PRs
      // floor comes from the catalog; the aliased package is pinned by the lockfile
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/pnpm-lock.yaml"
      ]
    },
    "//#typecheck:root": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "ci:pull_request": {
      "dependsOn": [
        "build",
        "test",
        "test:coverage",
        "test:lit2-compat",
        "test:mobx6-compat",
        "lint",
        "typecheck",
        "format:check",
        "check:bundle",
        "check:dev-split",
        "@tools/release#check:exports"
      ]
    },
    "check:bundle": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    // Reader of the two-pass build:js emit: asserts the declared dev-only
    // warnings ship in dist/development/*.js and in no dist/*.js. Own package's
    // build:js only — it reads that package's dist, nothing upstream.
    "check:dev-split": {
      "dependsOn": ["build:js"],
      "inputs": ["$TURBO_DEFAULT$", "dev-warnings.json"]
    },
    "ci:main": {
      // PR graph plus the main-only guards, scheduled by one turbo
      // invocation; future main-only guards join this dependsOn, not new
      // workflow steps.
      "dependsOn": [
        "ci:pull_request",
        "test:engines",
        "@tools/release#check:pack",
        "@tools/dts-backtest#test:matrix"
      ]
    },
    "ci": {
      // back-compat alias: `mise run ci` / `pnpm run ci` keep working
      "dependsOn": ["ci:pull_request"]
    },
    "codecov:bundle": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["CODECOV_TOKEN", "CI", "GITHUB_*"]
    },
    // WRITER. Rewrites its own inputs in place and declares no outputs, so a
    // cache hit restores nothing and silently leaves the tree unformatted;
    // uncacheable is the only correct setting. Not in any ci:* graph — the
    // gate is format:check. Run it ALONE: oxfmt truncates in place, so any
    // reader co-scheduled with it (lint:templates, test, format:check) can
    // observe a 0-byte source file.
    "format": {
      "with": ["//#format:root", "//#format:toml"],
      "cache": false
    },
    "format:check": {
      "with": ["//#format:check:root", "//#format:check:toml"],
      "inputs": [
        "**/*.{ts,js,mjs,cjs,json,jsonc,md,yml,yaml,html,vue}",
        "!dist/**",
        "!.cache/**",
        ".oxfmtrc.json",
        "$TURBO_ROOT$/.oxfmtrc.json"
      ]
    },
    // WRITER, uncacheable for the same reason as `format` above.
    "//#format:root": {
      "cache": false
    },
    "//#format:check:root": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    // taplo owns .toml, disjoint from the oxfmt writers above. WRITER,
    // uncacheable for the same reason as `format`. //#format:check:toml keeps
    // the .toml-scoped cache key.
    "//#format:toml": {
      "cache": false
    },
    "//#format:check:toml": {
      "inputs": [
        "**/*.toml",
        "!**/node_modules/**",
        "$TURBO_ROOT$/.config/taplo.toml",
        "$TURBO_ROOT$/.config/mise/tasks/taplo",
        "$TURBO_ROOT$/.config/mise/mise.lock"
      ]
    },
    "e2e": {
      "dependsOn": ["^build"],
      "with": ["docs#wrangler:dev"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "docs": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "docs:api": {
      // deliberately no self-chain (cf. build:types): it would serialize these
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"]
    }
  }
}
