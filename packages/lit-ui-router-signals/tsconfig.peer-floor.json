{
  // Typechecks src against the published floors of the lit-ui-router,
  // @uirouter/core and ui-router-signals peer ranges (the <peer>-floor aliases),
  // not the workspace or dev copies. Never emits.
  "extends": "./tsconfig.src.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "lit-ui-router": ["./node_modules/lit-ui-router-floor/dist/index.d.ts"],
      "lit-ui-router/pure": [
        "./node_modules/lit-ui-router-floor/dist/pure.d.ts"
      ],
      "lit-ui-router/context": [
        "./node_modules/lit-ui-router-floor/dist/context.d.ts"
      ],
      "lit-ui-router/*": ["./node_modules/lit-ui-router-floor/*"],
      "@uirouter/core": ["./node_modules/@uirouter/core-floor/lib/index.d.ts"],
      "ui-router-signals": [
        "./node_modules/ui-router-signals-floor/dist/index.d.ts"
      ],
      "ui-router-signals/*": ["./node_modules/ui-router-signals-floor/*"]
    }
  }
}
