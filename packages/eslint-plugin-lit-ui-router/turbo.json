{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "lint": {
      // `with` here replaces the root //# lane list for this package only;
      // those lanes still ride every other package's lint in a full sweep
      "with": ["lint:docs", "lint:rules"]
    },
    // eslint-doc-generator --check: generated rule docs cannot drift from meta
    "lint:docs": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    // eslint-plugin-eslint-plugin over the package's own rule source
    "lint:rules": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    // the RuleTester suite carries the eslint side; test:oxlint and the floor
    // lane ride alongside
    "test": {
      "with": ["test:oxlint", "test:peer-floor"]
    },
    // the same suite on the eslint-floor alias. Gated, unlike the adapters'
    // typecheck:peer-floor: the floor is a published eslint, never a workspace peer
    "test:peer-floor": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/pnpm-lock.yaml"
      ]
    },
    // oxlint `jsPlugins` over the fixture dir, gating at the exact catalog pin
    "test:oxlint": {
      "inputs": ["$TURBO_DEFAULT$"]
    }
  }
}
