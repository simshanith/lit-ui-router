{
  "$schema": "../../../../node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["eslint-plugin-lit-ui-router"],
  "settings": { "allowElementParts": false },
  "rules": {
    "lit-ui-router/anchor-is-valid": "error",
    "lit-ui-router/sref-active-class-aria-current": "error"
  },
  "overrides": [
    {
      "files": ["anchors.js"],
      "rules": {
        "lit-ui-router/anchor-is-valid": [
          "error",
          { "allowElementParts": true }
        ]
      }
    }
  ]
}
