{
  "name": "eslint-plugin-lit-ui-router",
  "version": "0.0.1",
  "private": true,
  "description": "ESLint rules that understand lit-ui-router directives: lit-a11y's anchor-is-valid, wrapped so a uiSref element part counts as the href it assigns at runtime",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "docs:rules": "eslint-doc-generator",
    "format": "oxfmt \"**/*.{ts,js,json,jsonc}\"",
    "format:check": "oxfmt --check \"**/*.{ts,js,json,jsonc}\"",
    "lint": "oxlint .",
    "lint:docs": "eslint-doc-generator --check",
    "lint:rules": "eslint .",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "eslint-plugin-lit": "catalog:publishedDependencies",
    "eslint-rule-extender": "catalog:publishedDependencies"
  },
  "devDependencies": {
    "@tools/eslint-ts-parser": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:peerFloor",
    "eslint-doc-generator": "catalog:",
    "eslint-plugin-eslint-plugin": "catalog:",
    "eslint-plugin-lit-a11y": "catalog:peerFloor",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "eslint": "catalog:publishedPeer",
    "eslint-plugin-lit-a11y": "catalog:publishedPeer"
  }
}
