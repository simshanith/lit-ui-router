{
  "name": "eslint-plugin-lit-ui-router",
  "version": "1.1.0",
  "private": false,
  "description": "ESLint rules that understand lit-ui-router directives: hrefless anchors, inert hrefs, aria-current conflicts and misplaced directives",
  "keywords": [
    "eslint",
    "eslintplugin"
  ],
  "homepage": "https://lit-ui-router.dev/packages/eslint-plugin",
  "bugs": {
    "url": "https://github.com/simshanith/lit-ui-router/issues"
  },
  "license": "MIT",
  "author": "Shane Daniel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simshanith/lit-ui-router.git",
    "directory": "packages/eslint-plugin-lit-ui-router"
  },
  "files": [
    "dist/**",
    "!dist/.*/**",
    "docs/**",
    "src/*.ts",
    "!src/*.spec.ts",
    "!src/*.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build:js": "oxc-emit-js",
    "build:types": "oxc-emit-dts",
    "changelog": "release-it --changelog --git.tagMatch=\"eslint-plugin-lit-ui-router@[0-9]*.[0-9]*.[0-9]*\"",
    "docs:rules": "eslint-doc-generator",
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,jsonc}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,jsonc}\"",
    "lint:docs": "eslint-doc-generator --check",
    "lint:oxlint": "oxlint --ignore-pattern test/oxlint .",
    "lint:rules": "eslint --config eslint.rules.config.js .",
    "test:oxlint": "node --test \"test/oxlint/*.spec.ts\"",
    "test:peer-floor": "peer-floor-guard && node --import ./test/eslint-floor.ts --test \"src/**/*.spec.ts\"",
    "test:unit": "node --test \"src/**/*.spec.ts\"",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "eslint-plugin-lit": "catalog:publishedDependencies"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "catalog:",
    "@tools/compat-guards": "catalog:workspace",
    "@tools/eslint-ts-parser": "catalog:workspace",
    "@tools/oxc-emit": "catalog:workspace",
    "@tools/release-config": "catalog:workspace",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-doc-generator": "catalog:",
    "eslint-floor": "catalog:peerFloorEslintPlugin",
    "eslint-plugin-eslint-plugin": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "release-it": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "eslint": "catalog:publishedPeer"
  },
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  }
}
