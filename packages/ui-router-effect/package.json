{
  "name": "ui-router-effect",
  "version": "0.1.2",
  "description": "Effect bindings for UI-Router: a framework-agnostic SubscriptionRef of the router's current state",
  "homepage": "https://lit-ui-router.dev/packages/ui-router-effect",
  "bugs": {
    "url": "https://github.com/simshanith/lit-ui-router/issues"
  },
  "license": "MIT",
  "author": "Shane Daniel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simshanith/lit-ui-router.git",
    "directory": "packages/ui-router-effect"
  },
  "files": [
    "dist/**",
    "!dist/.*/**",
    "src/*.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:js": "oxc-emit-js",
    "build:types": "oxc-emit-dts",
    "changelog": "release-it --changelog --git.tagMatch=\"ui-router-effect@[0-9]*.[0-9]*.[0-9]*\"",
    "check:bundle": "floor-guard && check-bundle-inputs",
    "codecov:bundle": "upload-entry-bundles",
    "docs:api": "rimraf ../../www/lit-ui-router.dev/api/ui-router-effect && typedoc",
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,md}\"",
    "lint:oxlint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:effect3-compat": "effect3-compat-guard && VITE_EXPECT_EFFECT_MAJOR=3 vitest run",
    "typecheck:effect3": "effect3-compat-guard && tsc -p tsconfig.effect3.json --noEmit",
    "typecheck:src": "tsc -p tsconfig.src.json --noEmit",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "catalog:",
    "@repo/route-snapshot": "catalog:workspace",
    "@tools/bundle-probe": "catalog:workspace",
    "@tools/compat-guards": "catalog:workspace",
    "@tools/lit-test-env": "catalog:workspace",
    "@tools/oxc-emit": "catalog:workspace",
    "@tools/release-config": "catalog:workspace",
    "@tools/typedoc-plugin-lit-ui-router": "catalog:workspace",
    "@types/node": "catalog:",
    "@uirouter/core": "catalog:",
    "@uirouter/core-floor": "catalog:peerFloor",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "effect-3": "catalog:effect3-compat",
    "effect-floor": "catalog:peerFloor",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "release-it": "catalog:",
    "rimraf": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-vitepress-theme": "catalog:",
    "typescript": "catalog:typescript6-compat",
    "typescript-7": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@uirouter/core": "catalog:publishedPeer",
    "effect": "catalog:publishedPeer"
  },
  "bundleProbe": {
    ".": {
      "free": [
        "lit",
        "lit-ui-router"
      ]
    }
  }
}
