{
  // Typechecks src against the published floor of the mobx peer range (the
  // mobx-floor alias), not the catalog's mobx 7. Never emits.
  // mobx 6 ships no exports map and src imports only the bare specifier.
  "extends": "./tsconfig.src.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "mobx": ["./node_modules/mobx-floor/dist/mobx.d.ts"]
    }
  }
}
