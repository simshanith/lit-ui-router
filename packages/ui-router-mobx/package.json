{
  "name": "ui-router-mobx",
  "version": "0.0.0",
  "private": true,
  "description": "MobX bindings for UI-Router: a framework-agnostic observable store of the router's current state",
  "homepage": "https://lit-ui-router.dev",
  "bugs": {
    "url": "https://github.com/simshanith/lit-ui-router/issues"
  },
  "license": "MIT",
  "author": "Shane Daniel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simshanith/lit-ui-router.git",
    "directory": "packages/ui-router-mobx"
  },
  "files": [
    "dist/**",
    "!dist/.*/**",
    "src/*.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:js": "oxc-emit-js",
    "build:types": "oxc-emit-dts",
    "check:bundle": "check-bundle-inputs",
    "codecov:bundle": "upload-entry-bundles",
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,md}\"",
    "lint:oxlint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mobx6-compat": "mobx6-compat-guard && VITE_EXPECT_MOBX_MAJOR=6 vitest run",
    "typecheck:mobx6": "mobx6-compat-guard && tsc -p tsconfig.mobx6.json --noEmit",
    "typecheck:src": "tsc -p tsconfig.src.json --noEmit",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tools/bundle-probe": "catalog:workspace",
    "@tools/compat-guards": "catalog:workspace",
    "@tools/lit-test-env": "catalog:workspace",
    "@tools/oxc-emit": "catalog:workspace",
    "@types/node": "catalog:",
    "@uirouter/core": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "mobx": "catalog:",
    "mobx-6": "catalog:mobx6-compat",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:typescript6-compat",
    "typescript-7": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@uirouter/core": "catalog:",
    "mobx": "catalog:"
  },
  "bundleProbe": {
    ".": {
      "free": [
        "lit",
        "lit-ui-router"
      ]
    }
  }
}
