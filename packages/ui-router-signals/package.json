{
  "name": "ui-router-signals",
  "version": "0.0.0",
  "private": true,
  "description": "TC39 Signals for UI-Router: a framework-agnostic signal mirror of the router's current state",
  "homepage": "https://lit-ui-router.dev",
  "bugs": {
    "url": "https://github.com/simshanith/lit-ui-router/issues"
  },
  "license": "MIT",
  "author": "Shane Daniel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simshanith/lit-ui-router.git",
    "directory": "packages/ui-router-signals"
  },
  "files": [
    "dist/**",
    "!dist/.*/**",
    "src/*.ts",
    "src/shared/*.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:js": "oxc-emit-js",
    "build:types": "oxc-emit-dts",
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,md}\"",
    "lint:oxlint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck:src": "tsc -p tsconfig.src.json --noEmit",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tools/lit-test-env": "catalog:workspace",
    "@tools/oxc-emit": "catalog:workspace",
    "@types/node": "catalog:",
    "@uirouter/core": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "signal-polyfill": "catalog:",
    "typescript": "catalog:typescript6-compat",
    "typescript-7": "catalog:",
    "vitest": "catalog:"
  }
}
