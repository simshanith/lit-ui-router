{
  // The node graph (tests and the bench); only here do node types exist.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["*.ts", "fixtures/**/*.ts", "../src/**/*"],
  // tsconfig.dom.json checks the tests that need lib.dom
  "exclude": ["vite-prerender.test.ts"]
}
