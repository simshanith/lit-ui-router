{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "docs:api": {
      "outputs": ["../../www/lit-ui-router.dev/api/ui-router-server/**"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    // root task keys inputs on vitest configs; this suite is node --test
    "test:coverage": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["coverage/**"]
    },
    // restates the root umbrella's list, plus this package's own leaves
    "typecheck": {
      "dependsOn": [
        "typecheck:tsc",
        "//#typecheck:root",
        "typecheck:src",
        "typecheck:lit2",
        "typecheck:mobx6",
        "typecheck:tests",
        "typecheck:runtime-globals"
      ]
    },
    "typecheck:tests": {
      "dependsOn": ["^build:types"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    // transit carries the dep closure's hashes: the shims this withdraws live
    // in @tools/wintercg-globals, so editing one must invalidate this task
    "typecheck:runtime-globals": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    }
  }
}
