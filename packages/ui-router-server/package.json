{
  "name": "ui-router-server",
  "version": "0.3.1",
  "description": "Server-side UI-Router state matching for Connect, Vite, Hono, and fetch handlers",
  "homepage": "https://lit-ui-router.dev/packages/server",
  "bugs": {
    "url": "https://github.com/simshanith/lit-ui-router/issues"
  },
  "license": "MIT",
  "author": "Shane Daniel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simshanith/lit-ui-router.git",
    "directory": "packages/ui-router-server"
  },
  "files": [
    "dist/**",
    "!dist/.*/**",
    "src/*.ts",
    "!src/*.spec.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/development/index.js",
      "deno": "./dist/index.js",
      "node": "./dist/node/index.js",
      "default": "./dist/index.js"
    },
    "./connect": {
      "types": "./dist/connect.d.ts",
      "development": "./dist/development/connect.js",
      "deno": "./dist/connect.js",
      "node": "./dist/node/connect.js",
      "default": "./dist/connect.js"
    },
    "./dist/*": "./dist/*",
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "development": "./dist/development/fetch.js",
      "deno": "./dist/fetch.js",
      "node": "./dist/node/fetch.js",
      "default": "./dist/fetch.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "development": "./dist/development/hono.js",
      "deno": "./dist/hono.js",
      "node": "./dist/node/hono.js",
      "default": "./dist/hono.js"
    },
    "./location": {
      "types": "./dist/location.d.ts",
      "development": "./dist/development/location.js",
      "deno": "./dist/location.js",
      "node": "./dist/node/location.js",
      "default": "./dist/location.js"
    },
    "./matcher": {
      "types": "./dist/url-matcher.d.ts",
      "development": "./dist/development/url-matcher.js",
      "deno": "./dist/url-matcher.js",
      "node": "./dist/node/url-matcher.js",
      "default": "./dist/url-matcher.js"
    },
    "./package.json": "./package.json",
    "./redirects": {
      "types": "./dist/redirects.d.ts",
      "development": "./dist/development/redirects.js",
      "deno": "./dist/redirects.js",
      "node": "./dist/node/redirects.js",
      "default": "./dist/redirects.js"
    },
    "./simulate": {
      "types": "./dist/simulate.d.ts",
      "development": "./dist/development/simulate.js",
      "deno": "./dist/simulate.js",
      "node": "./dist/node/simulate.js",
      "default": "./dist/simulate.js"
    },
    "./url-config": {
      "types": "./dist/url-config.d.ts",
      "development": "./dist/development/url-config.js",
      "deno": "./dist/url-config.js",
      "node": "./dist/node/url-config.js",
      "default": "./dist/url-config.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "development": "./dist/development/vite.js",
      "deno": "./dist/vite.js",
      "node": "./dist/node/vite.js",
      "default": "./dist/vite.js"
    }
  },
  "scripts": {
    "bench": "node test/resolve.bench.ts",
    "build:js": "oxc-emit-js --development --node",
    "build:types": "oxc-emit-dts",
    "changelog": "release-it --changelog --git.tagMatch=\"ui-router-server@[0-9]*.[0-9]*.[0-9]*\"",
    "check:bundle": "floor-guard && check-bundle-inputs",
    "check:dev-split": "oxc-emit-check-dev-split",
    "codecov:bundle": "upload-entry-bundles",
    "docs:api": "rimraf ../../www/lit-ui-router.dev/api/ui-router-server && typedoc",
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,md}\"",
    "lint:oxlint": "oxlint .",
    "test": "node --import ./test/import-meta-env.ts --test --test-reporter=@tools/shared/test-reporter.ts \"test/**/*.test.ts\"",
    "test:coverage": "mkdir -p coverage && node --import ./test/import-meta-env.ts --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-reporter=@tools/shared/test-reporter.ts --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.ts\" && rebase-lcov coverage/lcov.info",
    "typecheck:runtime-globals": "tsc -p tsconfig.runtime-globals.json --noEmit",
    "typecheck:src": "tsc -p tsconfig.src.json --noEmit",
    "typecheck:tests": "tsc -p test/tsconfig.json --noEmit",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "catalog:",
    "@tools/bundle-probe": "catalog:workspace",
    "@tools/compat-guards": "catalog:workspace",
    "@tools/lcov-rebase": "catalog:workspace",
    "@tools/oxc-emit": "catalog:workspace",
    "@tools/release-config": "catalog:workspace",
    "@tools/shared": "catalog:workspace",
    "@tools/typedoc-plugin-lit-ui-router": "catalog:workspace",
    "@tools/wintercg-globals": "catalog:workspace",
    "@types/node": "catalog:",
    "@uirouter/core": "catalog:",
    "@uirouter/core-floor": "catalog:peerFloor",
    "hono": "catalog:",
    "hono-floor": "catalog:peerFloor",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "release-it": "catalog:",
    "rimraf": "catalog:",
    "tinybench": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-vitepress-theme": "catalog:",
    "typescript": "catalog:typescript6-compat",
    "typescript-7": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@uirouter/core": "catalog:publishedPeer",
    "hono": "catalog:publishedPeer"
  },
  "peerDependenciesMeta": {
    "@uirouter/core": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "bundleProbe": {
    ".": {
      "free": [
        "@uirouter/core",
        "lit",
        "@lit-labs/ssr",
        "lit-ui-router"
      ],
      "conditions": [
        "node"
      ]
    },
    "./connect": {
      "free": [
        "@uirouter/core"
      ],
      "conditions": [
        "node"
      ]
    },
    "./fetch": {
      "free": [
        "@uirouter/core"
      ],
      "conditions": [
        "node"
      ]
    },
    "./hono": {
      "free": [
        "@uirouter/core",
        "hono"
      ],
      "conditions": [
        "node"
      ]
    },
    "./location": {
      "conditions": [
        "node"
      ]
    },
    "./matcher": {
      "free": [
        "@uirouter/core"
      ],
      "conditions": [
        "node"
      ]
    },
    "./redirects": {
      "free": [
        "@uirouter/core"
      ],
      "conditions": [
        "node"
      ]
    },
    "./simulate": {
      "conditions": [
        "node"
      ]
    },
    "./url-config": {
      "free": [
        "@uirouter/core"
      ],
      "conditions": [
        "node"
      ]
    },
    "./vite": {
      "free": [
        "@uirouter/core"
      ],
      "conditions": [
        "node"
      ]
    }
  }
}
