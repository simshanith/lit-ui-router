{
  // Typechecks src against the published floors of the @uirouter/core peer
  // range and the lit and valibot dependency ranges (the <dep>-floor aliases).
  // Never emits.
  "extends": "./tsconfig.src.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@uirouter/core": ["./node_modules/@uirouter/core-floor/lib/index.d.ts"],
      "lit": ["./node_modules/lit-floor/index.d.ts"],
      "lit/directives/repeat.js": [
        "./node_modules/lit-floor/directives/repeat.d.ts"
      ],
      "valibot": ["./node_modules/valibot-floor/dist/index.d.ts"]
    }
  }
}
