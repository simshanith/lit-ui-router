{
  "name": "ui-router-registry",
  "version": "0.3.0",
  "description": "Typed state names and params for UI-Router: a types-only registry for @uirouter/core",
  "homepage": "https://lit-ui-router.dev/packages/ui-router-registry",
  "bugs": {
    "url": "https://github.com/simshanith/lit-ui-router/issues"
  },
  "license": "MIT",
  "author": "Shane Daniel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simshanith/lit-ui-router.git",
    "directory": "packages/ui-router-registry"
  },
  "files": [
    "dist/**",
    "!dist/.*/**",
    "src/*.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./effect": {
      "types": "./dist/effect.d.ts",
      "default": "./dist/effect.js"
    },
    "./mobx": {
      "types": "./dist/mobx.d.ts",
      "default": "./dist/mobx.js"
    },
    "./package.json": "./package.json",
    "./signals": {
      "types": "./dist/signals.d.ts",
      "default": "./dist/signals.js"
    }
  },
  "scripts": {
    "bench:typecheck": "node bench/registry-types.bench.ts",
    "build:js": "oxc-emit-js",
    "build:types": "oxc-emit-dts",
    "changelog": "release-it --changelog --git.tagMatch=\"ui-router-registry@[0-9]*.[0-9]*.[0-9]*\"",
    "docs:api": "rimraf ../../www/lit-ui-router.dev/api/ui-router-registry && typedoc",
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,md}\"",
    "lint:oxlint": "oxlint .",
    "typecheck:peer-floor": "floor-guard && floor-types-guard tsconfig.peer-floor.json && tsc -p tsconfig.peer-floor.json --noEmit",
    "typecheck:src": "tsc -p tsconfig.src.json --noEmit",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit && tsc -p test-d/tsconfig.json --noEmit && tsc -p test-d/routed-components/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "catalog:",
    "@tools/compat-guards": "catalog:workspace",
    "@tools/oxc-emit": "catalog:workspace",
    "@tools/release-config": "catalog:workspace",
    "@tools/typedoc-plugin-lit-ui-router": "catalog:workspace",
    "@types/node": "catalog:",
    "@uirouter/core": "catalog:",
    "@uirouter/core-floor": "catalog:peerFloor",
    "effect": "catalog:",
    "lit": "catalog:",
    "lit-ui-router": "catalog:workspace",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "release-it": "catalog:",
    "rimraf": "catalog:",
    "tinybench": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-vitepress-theme": "catalog:",
    "typescript": "catalog:typescript6-compat",
    "typescript-5.0": "catalog:",
    "typescript-5.9": "catalog:",
    "typescript-7": "catalog:",
    "ui-router-effect": "catalog:workspace",
    "ui-router-mobx": "catalog:workspace",
    "ui-router-signals": "catalog:workspace"
  },
  "peerDependencies": {
    "@uirouter/core": "catalog:publishedPeer",
    "ui-router-effect": "catalog:publishedPeerEffect",
    "ui-router-mobx": "catalog:publishedPeerMobx",
    "ui-router-signals": "catalog:publishedPeerSignals"
  },
  "peerDependenciesMeta": {
    "ui-router-effect": {
      "optional": true
    },
    "ui-router-mobx": {
      "optional": true
    },
    "ui-router-signals": {
      "optional": true
    }
  }
}
