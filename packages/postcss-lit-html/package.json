{
  "name": "postcss-lit-html",
  "version": "0.0.0",
  "private": true,
  "description": "postcss-lit plus the CSS of <style> elements in lit html and svg templates, as one PostCSS syntax for stylelint",
  "homepage": "https://lit-ui-router.dev",
  "bugs": {
    "url": "https://github.com/simshanith/lit-ui-router/issues"
  },
  "license": "MIT",
  "author": "Shane Daniel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simshanith/lit-ui-router.git",
    "directory": "packages/postcss-lit-html"
  },
  "files": [
    "dist/**",
    "!dist/.*/**",
    "src/*.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:js": "oxc-emit-js",
    "build:types": "oxc-emit-dts",
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,md}\"",
    "lint:oxlint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck:src": "tsc -p tsconfig.src.json --noEmit",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@babel/parser": "catalog:",
    "@babel/types": "catalog:",
    "parse5": "catalog:",
    "postcss-lit": "catalog:"
  },
  "devDependencies": {
    "@tools/oxc-emit": "catalog:workspace",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "postcss": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "postcss": "catalog:"
  }
}
