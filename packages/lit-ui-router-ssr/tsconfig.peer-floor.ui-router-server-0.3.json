{
  // Typechecks src against the floor of the ui-router-server ^0.3.0 peer leg
  // (the ui-router-server-0.3-floor alias). Never emits.
  "extends": "./tsconfig.src.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "ui-router-server": [
        "./node_modules/ui-router-server-0.3-floor/dist/index.d.ts"
      ],
      "ui-router-server/*": ["./node_modules/ui-router-server-0.3-floor/*"]
    }
  }
}
