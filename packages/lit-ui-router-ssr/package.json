{
  "name": "lit-ui-router-ssr",
  "version": "0.7.0",
  "description": "Static prerendering for lit-ui-router: mount verdicts in, an emitted site out",
  "homepage": "https://lit-ui-router.dev/packages/ssr",
  "bugs": {
    "url": "https://github.com/simshanith/lit-ui-router/issues"
  },
  "license": "MIT",
  "author": "Shane Daniel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simshanith/lit-ui-router.git",
    "directory": "packages/lit-ui-router-ssr"
  },
  "files": [
    "dist/**",
    "!dist/.*/**",
    "src/*.ts"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/register.js",
    "./dist/development/register.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#dev-gate": {
      "types": "./src/dev-gate.ts",
      "production": "./dist/dev-gate.js",
      "deno": "./dist/dev-gate.js",
      "node": "./dist/dev-gate.node.js",
      "default": "./dist/dev-gate.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/development/index.js",
      "production": "./dist/index.js",
      "deno": "./dist/index.js",
      "node": "./dist/development/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "development": "./dist/development/client.js",
      "production": "./dist/client.js",
      "deno": "./dist/client.js",
      "node": "./dist/development/client.js",
      "default": "./dist/client.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json",
    "./register": {
      "types": "./dist/register.d.ts",
      "development": "./dist/development/register.js",
      "production": "./dist/register.js",
      "deno": "./dist/register.js",
      "node": "./dist/development/register.js",
      "default": "./dist/register.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "development": "./dist/development/testing.js",
      "production": "./dist/testing.js",
      "deno": "./dist/testing.js",
      "node": "./dist/development/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build:js": "oxc-emit-js --development",
    "build:types": "oxc-emit-dts",
    "changelog": "release-it --changelog --git.tagMatch=\"lit-ui-router-ssr@[0-9]*.[0-9]*.[0-9]*\"",
    "check:bundle": "floor-guard && check-bundle-inputs",
    "check:dev-split": "oxc-emit-check-dev-split",
    "codecov:bundle": "upload-entry-bundles",
    "crap": "crap-report",
    "docs:api": "rimraf ../../www/lit-ui-router.dev/api/lit-ui-router-ssr && typedoc",
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,md}\"",
    "lint:oxlint": "oxlint .",
    "test": "VITEST_BROWSER_API_PORT=63360 vitest run",
    "test:coverage": "VITEST_BROWSER_API_PORT=63365 vitest run --coverage",
    "typecheck:peer-floor": "floor-guard && floor-types-guard tsconfig.peer-floor.json && tsc -p tsconfig.peer-floor.json --noEmit",
    "typecheck:src": "tsc -p tsconfig.src.json --noEmit",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@oxc-project/runtime": "catalog:publishedDependencies"
  },
  "devDependencies": {
    "@lit-labs/ssr": "catalog:",
    "@lit-labs/ssr-client": "catalog:",
    "@lit-labs/ssr-client-floor": "catalog:peerFloorSsr",
    "@lit-labs/ssr-floor": "catalog:peerFloorSsr",
    "@oxc-project/runtime-floor": "catalog:oxc-compat",
    "@release-it/conventional-changelog": "catalog:",
    "@repo/dev-gate": "catalog:workspace",
    "@tools/bundle-probe": "catalog:workspace",
    "@tools/compat-guards": "catalog:workspace",
    "@tools/crap": "catalog:workspace",
    "@tools/lit-test-env": "catalog:workspace",
    "@tools/oxc-emit": "catalog:workspace",
    "@tools/release-config": "catalog:workspace",
    "@tools/typedoc-plugin-lit-ui-router": "catalog:workspace",
    "@types/node": "catalog:",
    "@uirouter/core": "catalog:",
    "@uirouter/core-floor": "catalog:peerFloor",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "lit": "catalog:",
    "lit-ui-router": "catalog:workspace",
    "lit-ui-router-floor": "catalog:peerFloorSsr",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "release-it": "catalog:",
    "rimraf": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-vitepress-theme": "catalog:",
    "typescript": "catalog:typescript6-compat",
    "typescript-7": "catalog:",
    "ui-router-server": "catalog:workspace",
    "ui-router-server-floor": "catalog:peerFloorSsr",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@lit-labs/ssr": "catalog:publishedPeerSsr",
    "@lit-labs/ssr-client": "catalog:publishedPeerSsr",
    "@uirouter/core": "catalog:publishedPeer",
    "lit": "catalog:publishedPeerSsr",
    "lit-ui-router": "catalog:publishedPeerSsr",
    "ui-router-server": "catalog:publishedPeerSsr"
  },
  "peerDependenciesMeta": {
    "@lit-labs/ssr-client": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "bundleProbe": {
    ".": {
      "free": [
        "hono",
        "vite",
        "node:fs",
        "node:path"
      ]
    },
    "./client": {
      "free": [
        "@lit-labs/ssr",
        "hono",
        "vite",
        "node:fs",
        "node:path"
      ]
    },
    "./register": {
      "free": [
        "@lit-labs/ssr",
        "hono",
        "vite",
        "node:fs",
        "node:path"
      ]
    },
    "./testing": {
      "free": [
        "@lit-labs/ssr",
        "@lit-labs/ssr-client",
        "@uirouter/core",
        "lit",
        "lit-ui-router",
        "ui-router-server",
        "hono",
        "vite",
        "node:fs",
        "node:path"
      ]
    }
  }
}
