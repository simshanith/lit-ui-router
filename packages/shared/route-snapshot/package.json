{
  "name": "@repo/route-snapshot",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical source of snapshotRoute and RouteSnapshot, copied into each consuming package's src/shared/ by sync:shared-source",
  "type": "module",
  "scripts": {
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,jsonc,md}\"",
