    "lint:oxlint": "oxlint .",
    "test": "vitest run",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tools/lit-test-env": "catalog:workspace",
    "@types/node": "catalog:",
    "@uirouter/core": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
