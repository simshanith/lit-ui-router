{
  "name": "@repo/dev-gate",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical source of both halves of each package's #dev-gate import, inlined into its dist/ by oxc-emit",
  "type": "module",
  "exports": {
    ".": "./src/dev-gate.ts",
    "./node": "./src/dev-gate.node.ts"
  },
  "scripts": {
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,jsonc,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,jsonc,md}\"",
    "lint:oxlint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
