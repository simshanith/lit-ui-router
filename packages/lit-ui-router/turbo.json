{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // ordered, not `with`: consumers reach the manifest through `^build`, and
      // an unordered sidecar let them start bundling before it was written
      "dependsOn": [
        "^build",
        "build:js",
        "build:types",
        "build:custom-elements"
      ],
      // the manifest is the other task's output, so keep it out of this archive
      "outputs": ["dist/**", "!dist/custom-elements.json"]
    },
    "build:custom-elements": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.ts",
        "custom-elements-manifest.config.js"
      ],
      "outputs": ["dist/custom-elements.json"]
    },
    "docs:api": {
      "outputs": ["../../www/lit-ui-router.dev/api/reference/**"]
    }
  }
}
