{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // the manifest is a published output: `build` is not done without it
      "dependsOn": [
        "^build",
        "build:js",
        "build:types",
        "build:custom-elements"
      ],
      // but it belongs to the task that writes it, not to both archives
      "outputs": ["dist/**", "!dist/custom-elements.json"]
    },
    "build:custom-elements": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.ts",
        "custom-elements-manifest.config.js"
      ],
      "outputs": ["dist/custom-elements.json"]
    },
    "docs:api": {
      "outputs": ["../../www/lit-ui-router.dev/api/reference/**"]
    }
  }
}
