{
  "name": "lit-ui-router-example-lint-eslint",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint .",
    "lint:tap": "eslint . --format tap",
    "lint:watch": "chokidar \"src/**/*.ts\" eslint.config.js --initial --command \"eslint . --format pretty && echo lint clean\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@uirouter/core": "^6.1.2",
    "lit": "^3.3.3",
    "lit-ui-router": "^1.11.2"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "eslint": "^10.9.0",
    "eslint-formatter-pretty": "^7.1.0",
    "eslint-formatter-tap": "^9.0.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-lit-ui-router": "1.0.0-rc.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "onFail": "warn"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
