{
  "name": "lit-ui-router-tutorial-helloworld-buildless",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --eval \"fs.cpSync('public', 'dist', { recursive: true })\" --",
    "dev": "serve --no-clipboard public",
    "preview": "serve --no-clipboard dist"
  },
  "devDependencies": {
    "@uirouter/core": "^6.1.2",
    "lit": "^3.3.3",
    "lit-ui-router": "^1.19.0",
    "serve": "^14.2.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "serve": {
      "compression": "^1.8.2"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "onFail": "warn"
    }
  }
}
