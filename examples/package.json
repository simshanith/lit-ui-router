{
  "name": "examples",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./embeds": "./embeds.ts"
  },
  "scripts": {
    "build:embeds": "node build-embeds.ts",
    "example:install:design-system-links": "npm ci --prefix design-system-links",
    "example:install:hellogalaxy": "npm ci --prefix hellogalaxy",
    "example:install:hellogalaxy-effect": "npm ci --prefix hellogalaxy-effect",
    "example:install:hellosolarsystem": "npm ci --prefix hellosolarsystem",
    "example:install:hellosolarsystem-mobx": "npm ci --prefix hellosolarsystem-mobx",
    "example:install:helloworld": "npm ci --prefix helloworld",
    "example:install:lint-eslint": "npm ci --prefix lint-eslint",
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,js,json,md,html}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,js,json,md,html}\"",
    "postinstall": "concurrently \"npm:example:install:*\"",
    "lint:example:lint-eslint": "npm run lint --prefix lint-eslint",
    "lint:examples": "concurrently --prefix-colors auto \"npm:lint:example:*\"",
    "lint:oxlint": "oxlint .",
    "test": "node --test --test-reporter=@tools/shared/test-reporter.ts \"*.test.ts\"",
    "typecheck:example:design-system-links": "tsc -p design-system-links",
    "typecheck:example:hellogalaxy": "tsc -p hellogalaxy",
    "typecheck:example:hellogalaxy-effect": "tsc -p hellogalaxy-effect",
    "typecheck:example:hellosolarsystem": "tsc -p hellosolarsystem",
    "typecheck:example:hellosolarsystem-mobx": "tsc -p hellosolarsystem-mobx",
    "typecheck:example:helloworld": "tsc -p helloworld",
    "typecheck:example:lint-eslint": "tsc -p lint-eslint",
    "typecheck:tsc": "concurrently --prefix-colors auto \"npm:typecheck:example:*\""
  },
  "devDependencies": {
    "@tools/shared": "catalog:workspace",
    "concurrently": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
