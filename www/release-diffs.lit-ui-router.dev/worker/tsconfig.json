{
  // The workerd graph, without node types; .cloudflare/types is generated by
  // types:worker, not committed.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // The cf-worker import attribute in cloudflare.config.ts needs esnext.
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2022"],
    "types": []
  },
  "include": [
    "index.ts",
    "test/*.ts",
    "../cloudflare.config.ts",
    "../.cloudflare/types"
  ]
}
