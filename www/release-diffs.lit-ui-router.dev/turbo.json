{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // restates the root umbrella's list, plus this package's own leaves
    "typecheck": {
      "dependsOn": [
        "typecheck:tsc",
        "//#typecheck:root",
        "typecheck:src",
        "typecheck:lit2",
        "typecheck:mobx6",
        "typecheck:effect3",
        "typecheck:worker"
      ]
    },
    "typecheck:worker": {
      "dependsOn": ["^build:types", "types:worker"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "lint:oxlint": {
      // Type-aware oxlint reads worker/tsconfig.json, which needs the d.ts.
      "dependsOn": ["^build:types", "types:worker"],
      // The root task's explicit globs would hash the gitignored d.ts, which
      // cloudflare.config.ts already keys.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    "format:check:oxfmt": {
      // The root task's explicit glob would hash the gitignored
      // .cloudflare/types and re-key on every types:worker run.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxfmtrc.json"]
    },
    // The npm diff port against the npm CLI, both reading the npm registry:
    // the network and the host's npm are inputs no key can name, so uncached.
    // In no ci:* graph: the Acceptance workflow's `acceptance (npm-diff)` job
    // runs it.
    "test:npm-diff": {
      "cache": false
    },
    "types:worker": {
      "inputs": ["$TURBO_DEFAULT$", "cloudflare.config.ts"],
      "outputs": [".cloudflare/types/**"]
    }
  }
}
