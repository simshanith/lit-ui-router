{
  "name": "@www/release-diffs.lit-ui-router.dev",
  "version": "0.0.0",
  "private": true,
  "description": "The release-diffs worker, answering 404 until the ReleaseDiff Durable Object lands",
  "type": "module",
  "scripts": {
    "format:check:oxfmt": "oxfmt --check \"**/*.{ts,json,jsonc,md}\"",
    "format:oxfmt": "oxfmt \"**/*.{ts,json,jsonc,md}\"",
    "lint:oxlint": "oxlint .",
    "typecheck:worker": "tsc -p worker/tsconfig.json --noEmit",
    "types:worker": "cf workers types"
  },
  "devDependencies": {
    "cf": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
