{
  "name": "altitude-atlas-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node prerender.ts",
    "build:artifact": "vite build --mode artifact && node artifact.ts",
    "build:spa": "vite build",
    "dev": "vite",
    "lint": "oxlint . && eslint .",
    "prerender": "node prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "bench": "node test/routes.bench.ts"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "@lit-labs/ssr-client": "^1.1.8",
    "@uirouter/core": "^6.1.2",
    "@uirouter/visualizer": "^7.2.1",
    "cytoscape": "^3.34.3",
    "effect": "^3.22.2",
    "lit": "^3.3.3",
    "lit-ui-router": "^1.17.0",
    "lit-ui-router-effect": "^0.5.0",
    "three": "^0.186.0",
    "ui-router-effect": "^0.1.2",
    "ui-router-navigation-location-plugin": "^1.2.0",
    "ui-router-server": "^0.4.0"
  },
  "devDependencies": {
    "@lit-labs/ssr": "^4.1.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-lit-ui-router": "^1.3.0",
    "eslint-plugin-oxlint": "1.86.0",
    "lit-ui-router-ssr": "^0.4.0",
    "oxlint": "1.86.0",
    "tinybench": "^6.2.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "onFail": "warn"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "overrides": {
    "@google/model-viewer": {
      "three": "$three"
    }
  }
}
