// https://developers.cloudflare.com/workers/static-assets/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lit-ui-router",
  "compatibility_date": "2026-07-01",
  "main": "./worker/index.ts",
  // Resolved from this directory, where every wrangler script runs.
  "alias": { "lit-html/is-server.js": "./worker/is-server.ts" },
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Sample-app deep links and the 404-pattern exhibits invoke the worker;
    // other misses serve 404.html. EVERY mount lists its bare path too, not
    // just the `/*` wildcard: a `/*` pattern matches `/app/foo` but NOT the
    // bare mount root `/app`, and the root is exactly where the verdict that
    // differs from the plain asset lives — the flagship's `/` -> welcome 302,
    // and /app-hash's shell-at-200 (its own `app-hash.html`, not the vanilla
    // shell html_handling would serve at `/app-hash`). Omit the bare path and
    // html_handling answers before the worker runs, shadowing that verdict.
    // The exhibits also need their bare paths because no asset exists there —
    // the whole prefix is the demo.
    "run_worker_first": [
      "/app",
      "/app/*",
      "/app-mobx",
      "/app-mobx/*",
      "/app-effect",
      "/app-effect/*",
      "/app-signals",
      "/app-signals/*",
      "/app-hash",
      "/app-hash/*",
      "/not-found-naive",
      "/not-found-naive/*",
      "/not-found-spa",
      "/not-found-spa/*",
      "/simulated-routing",
      "/simulated-routing/*",
      // The release pages and the /gh redirects, answered from the release ledger.
      "/releases",
      "/releases/*",
      "/gh",
      "/gh/*",
    ],
  },
  // Read-only RPC into the release ledger worker; the docs worker holds no D1 binding.
  "services": [
    {
      "binding": "LEDGER",
      "service": "release-ledger",
      "entrypoint": "LedgerReader",
    },
    // The release-diffs worker's default entrypoint: each pair's npm diff, built once into R2.
    { "binding": "RELEASE_DIFFS", "service": "release-diffs" },
  ],
}
