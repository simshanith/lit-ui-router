{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "bundle:worker": {
      // --dry-run only bundles worker src (the script stubs an empty dist:
      // assets ship via the binding, never inside index.js), so docs content
      // can't affect the artifact; workspace deps ride the transit chain.
      "dependsOn": ["transit"],
      "inputs": [
        "package.json",
        "worker/**",
        "!worker/dist/**",
        // types:worker output; esbuild bundles, it never typechecks, so
        // regenerating the d.ts must not bust this key
        "!worker/worker-configuration.d.ts",
        "wrangler.jsonc",
        "$TURBO_ROOT$/pnpm-lock.yaml"
      ],
      "outputs": ["worker/dist/**"]
    },
    "check:embeds": {
      // Reader of the built examples: measures each in Chromium and checks the
      // heights examples.ts reserves for them. Uncached because the result is a
      // property of the host — its Chromium build and its installed fonts —
      // and no `inputs` glob can name either, so a hit would replay a
      // measurement this machine never took.
      "dependsOn": ["examples#build:embeds"],
      "cache": false
    },
    "codecov:bundle": {
      // Upload-only: ships the (possibly cache-replayed) dry-run artifact.
      "dependsOn": ["bundle:worker"]
    },
    "docs:preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "wrangler:dev": {
      "dependsOn": ["build"],
      // Overrides of the launcher's defaults (dev-port.ts, the worker build);
      // the task is uncached, so they pass through.
      "passThroughEnv": [
        "WWW_DEV_PORT",
        "WWW_WORKER_BUILD",
        "WRANGLER_BUILD_CONDITIONS"
      ],
      "cache": false,
      "persistent": true
    },
    "build": {
      // @www/lit-ui-router.dev imports no producer, so `^` cannot reach the docs:api tasks
      "dependsOn": [
        "^build",
        "lit-ui-router#docs:api",
        "lit-ui-router-effect#docs:api",
        "lit-ui-router-mobx#docs:api",
        "lit-ui-router-signals#docs:api",
        "lit-ui-router-ssr#docs:api",
        "ui-router-effect#docs:api",
        "ui-router-mobx#docs:api",
        "ui-router-navigation-location-plugin#docs:api",
        "ui-router-registry#docs:api",
        "ui-router-server#docs:api",
        "ui-router-signals#docs:api",
        "examples#build:embeds",
        "types:worker"
      ],
      "env": ["VITE_GOOGLE_ANALYTICS_TRACKING_ID"]
    },
    // restates the root umbrella's list, plus this package's own leaves
    "typecheck": {
      "dependsOn": [
        "typecheck:tsc",
        "//#typecheck:root",
        "typecheck:src",
        "typecheck:lit2",
        "typecheck:mobx6",
        "typecheck:effect3",
        "typecheck:vue",
        "typecheck:worker",
        "typecheck:worker:tests"
      ]
    },
    "typecheck:tsc": {
      "dependsOn": [
        "^build:types",
        "lit-ui-router#docs:api",
        "lit-ui-router-effect#docs:api",
        "lit-ui-router-mobx#docs:api",
        "lit-ui-router-signals#docs:api",
        "lit-ui-router-ssr#docs:api",
        "ui-router-effect#docs:api",
        "ui-router-mobx#docs:api",
        "ui-router-navigation-location-plugin#docs:api",
        "ui-router-registry#docs:api",
        "ui-router-server#docs:api",
        "ui-router-signals#docs:api"
      ]
    },
    "test": {
      // The worker contract tests run the worker module in node; workspace
      // sources resolve directly (no build), but the root task's src/**
      // inputs would miss worker/**, so over-approximate.
      "inputs": ["$TURBO_DEFAULT$"]
    },
    // The diff page's npm diff against the npm CLI, both reading the npm
    // registry: the network and the host's npm are inputs no key can name, so
    // uncached. In no ci:* graph: the Acceptance workflow's
    // `acceptance (npm-diff)` job runs it.
    "test:npm-diff": {
      "cache": false
    },
    "typecheck:worker": {
      "dependsOn": ["^build:types", "types:worker"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "typecheck:worker:tests": {
      // The worker module rides into the test graph, so the generated
      // worker-configuration.d.ts must exist here too.
      "dependsOn": ["^build:types", "types:worker"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "lint:oxlint": {
      // Type-aware oxlint reads worker/tsconfig.json, which needs the d.ts.
      "dependsOn": ["^build:types", "types:worker"]
    },
    "format:check:oxfmt": {
      // api/ is typedoc output: gitignored, so oxfmt skips it, but the root
      // task's explicit glob would hash it and re-key on every docs:api run.
      // $TURBO_DEFAULT$ over-approximates the extension list and is the only
      // input form turbo gitignore-prunes.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxfmtrc.json"]
    },
    "types:worker": {
      "inputs": ["$TURBO_DEFAULT$", "wrangler.jsonc"],
      "outputs": ["worker/worker-configuration.d.ts"]
    },
    "docs": {
      "dependsOn": [
        "^build",
        "lit-ui-router#docs:api",
        "lit-ui-router-effect#docs:api",
        "lit-ui-router-mobx#docs:api",
        "lit-ui-router-signals#docs:api",
        "lit-ui-router-ssr#docs:api",
        "ui-router-effect#docs:api",
        "ui-router-mobx#docs:api",
        "ui-router-navigation-location-plugin#docs:api",
        "ui-router-registry#docs:api",
        "ui-router-server#docs:api",
        "ui-router-signals#docs:api",
        "examples#build:embeds"
      ],
      "cache": false,
      "persistent": true,
      // dev-server browser open toggle (vite.config.ts server.open)
      "env": ["E2E_TEST"]
    },
    "typecheck:vue": {
      "dependsOn": ["^build:types"],
      // vue-tsc follows what the components import, not just the component glob
      "inputs": [
        "$TURBO_DEFAULT$",
        ".vitepress/env.d.ts",
        ".vitepress/theme/components/*.vue",
        "tsconfig.json",
        "tsconfig.vue.json"
      ]
    }
  }
}
