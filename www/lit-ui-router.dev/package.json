{
  "name": "@www/lit-ui-router.dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./dev-port.ts": "./dev-port.ts"
  },
  "scripts": {
    "build": "vitepress build .",
    "bundle:worker": "mkdir -p dist && wrangler deploy --dry-run --outdir=\"$PWD/worker/dist\"",
    "check:embeds": "check-embed-heights",
    "codecov:bundle": "upload-bundle-stats docs-worker-esm worker/dist --no-manifest",
    "docs": "vitepress dev .",
    "docs:preview": "vitepress preview .",
    "format": "oxfmt \"**/*.{md,json,ts,vue}\"",
    "format:check": "oxfmt --check \"**/*.{md,json,ts,vue}\"",
    "lint": "oxlint .",
    "test": "node --test \"worker/test/*.test.ts\" \".vitepress/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:vue": "vue-check www/lit-ui-router.dev/tsconfig.vue.json",
    "typecheck:worker": "tsc -p worker/tsconfig.json --noEmit",
    "typecheck:worker:tests": "tsc -p worker/test/tsconfig.json --noEmit",
    "types:worker": "wrangler types worker/worker-configuration.d.ts",
    "wrangler:dev": "node ./scripts/wrangler-dev.ts"
  },
  "dependencies": {
    "@spectrum-web-components/icons-workflow": "catalog:",
    "examples": "catalog:",
    "sample-app-lit-effect": "catalog:",
    "sample-app-lit-mobx": "catalog:",
    "sample-app-lit-vanilla": "catalog:",
    "sample-app-routes": "catalog:",
    "screenfull": "catalog:",
    "ui-router-server": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@tools/build_and_test": "catalog:",
    "@tools/embed-heights": "catalog:",
    "@tools/shared": "catalog:",
    "@tools/vue-check": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-static-copy": "catalog:",
    "vitepress": "catalog:",
    "wrangler": "catalog:"
  }
}
