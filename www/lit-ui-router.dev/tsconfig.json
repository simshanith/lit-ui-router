{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // esnext for the import attributes in config.ts
    "module": "esnext",
    "moduleResolution": "bundler",
    // The vite config consumes ui-router-server/sample-app-routes as source
    // (workspace exports point at .ts), whose imports carry .ts extensions —
    // the same allowance worker/tsconfig.json already makes.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": true,
    "sourceMap": true
  },
  // The diff page's client is browser code; the worker tsconfig never reaches it.
  "include": [
    ".vitepress/**/*",
    "dev-port.ts",
    "scripts/**/*",
    "worker/releases/release-diff.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
